{%- comment -%}
  Puredeco · collectiepagina in de huisstijl.
  Hero met de SEO-H1 (metafield custom.seo_h1, anders de collectietitel), collectienavigatie met interne links,
  filters en sortering (nofollow), productkaarten zonder winkelwagenknop (Bekijk en bereken + Sample),
  echte paginalinks i.p.v. oneindig scrollen, opgeschoonde collectietekst, veelgestelde vragen en structured data.
  URL's van collecties en producten blijven ongewijzigd.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign h1 = collection.metafields.custom.seo_h1.value | default: collection.title
  capture seo_h1
    render 'pd-seo', part: 'h1', c: collection
  endcapture
  capture seo_intro
    render 'pd-seo', part: 'intro', c: collection
  endcapture
  capture seo_body
    render 'pd-seo', part: 'body', c: collection
  endcapture
  capture seo_desc
    render 'pd-seo', part: 'desc', c: collection
  endcapture
  assign seo_h1 = seo_h1 | strip
  assign seo_intro = seo_intro | strip
  assign seo_body = seo_body | strip
  assign seo_desc = seo_desc | strip | default: page_description
  if seo_h1 != blank
    assign h1 = seo_h1
  endif
  capture clean
    render 'pd-clean-html', html: collection.description
  endcapture
  assign body = clean
  assign per_page = s.per_page | default: 24
  comment
    Uit het assortiment (alleen verbergen in dit thema; het product blijft in Shopify bestaan)
  endcomment
  assign pd_hidden = '668-glanzend-marmer-florentine-limestone'
  assign pd_hidden_n = collection.products | where: 'handle', '668-glanzend-marmer-florentine-limestone' | size
  assign pd_count = collection.products_count | minus: pd_hidden_n
  assign sample_max = s.sample_max | default: 5
-%}

<div class="ph pc" data-pc data-max="{{ sample_max }}" data-prop="Voorbeeld van">

  {%- comment -%} Kop: compact, zodat de decors direct in beeld staan {%- endcomment -%}
  <header class="pc-head">
    <div class="ph-wrap pc-head__in">
      <div class="pc-head__t">
        <p class="ph-k ph-k--bronze">{{ s.eyebrow | default: 'Wandpanelen met bamboekern' }}</p>
        <h1 class="pc-head__h">{{ h1 }}</h1>
      </div>
      <ul class="pc-usp" role="list">
        <li><strong>{{ pd_count }}</strong> {% if pd_count == 1 %}decor{% else %}decors{% endif %}</li>
        <li>Gratis samples · € 6,95 verzending</li>
        <li>3 jaar garantie</li>
      </ul>
    </div>
    {%- if seo_intro != blank and current_page == 1 -%}
      <div class="ph-wrap"><div class="pc-head__intro">{{ seo_intro }}</div></div>
    {%- endif -%}
  </header>

  {%- comment -%} Collectienavigatie: interne links met beschrijvende ankertekst {%- endcomment -%}
  {%- assign nav = s.nav | newline_to_br | split: '<br />' -%}
  <nav class="pc-nav" aria-label="Collecties">
    <div class="ph-wrap">
      <ul class="pc-nav__list" role="list">
        {%- for line in nav -%}
          {%- assign pair = line | strip | split: '|' -%}
          {%- if pair.size == 2 -%}
            {%- assign nh = pair[0] | strip -%}
            {%- assign nl = pair[1] | strip -%}
            <li><a href="/collections/{{ nh }}"{% if nh == collection.handle %} aria-current="page" class="is-on"{% endif %}>{{ nl }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </nav>

  {%- paginate collection.products by per_page -%}
  <section class="pc-shop" id="decors">
    <div class="ph-wrap">

      <div class="pc-bar">
        <p class="pc-bar__count"><strong>{{ pd_count }}</strong> {% if pd_count == 1 %}decor{% else %}decors{% endif %}</p>
        {%- if s.show_filters and collection.filters.size > 0 -%}
          {%- comment -%}
            Filterwaarden zijn in de productdata niet overal gelijk geschreven ("8mm Naadloos", "8mm (naadloos)", "5mm stomp").
            We tonen per betekenis één knop; die zet of verwijdert alle bijbehorende waarden tegelijk.
          {%- endcomment -%}
          {%- liquid
            assign active_q = ''
            for filter in collection.filters
              if filter.type == 'list'
                for av in filter.active_values
                  assign ev = av.value | url_param_escape
                  assign active_q = active_q | append: '&' | append: av.param_name | append: '=' | append: ev | append: '¦'
                endfor
              endif
            endfor
            assign sort_q = collection.sort_by | default: collection.default_sort_by
          -%}
          <div class="pc-filters">
            {%- for filter in collection.filters -%}
              {%- comment -%} Dikte (optie "Afwerking") is in de productdata op meerdere manieren gespeld; Shopify combineert die waarden
                als "en", dus een samengevoegde knop geeft te weinig resultaten. Verborgen tot de optiewaarden gelijk zijn;
                de collectie Naadloze wandpanelen staat in de navigatie. {%- endcomment -%}
              {%- if filter.type == 'list' and filter.values.size > 1 and filter.label contains 'fwerking' -%}{%- continue -%}{%- endif -%}
              {%- if filter.type == 'list' and filter.values.size > 1 -%}
                {%- liquid
                  assign keys = ''
                  for v in filter.values
                    if v.count > 0 or v.active
                      assign k = v.label | downcase | remove: ' ' | remove: '(' | remove: ')'
                      if k contains '8mm'
                        assign k = '8 mm naadloos'
                      elsif k contains '5mm'
                        assign k = '5 mm stomp'
                      else
                        assign k = v.label | strip
                      endif
                      assign kk = '|' | append: k | append: '|'
                      unless keys contains kk
                        assign keys = keys | append: kk
                      endunless
                    endif
                  endfor
                  assign key_list = keys | remove_first: '|' | split: '||'
                -%}
                {%- if key_list.size > 1 -%}
                <div class="pc-filter" role="group" aria-label="{{ filter.label | escape }}">
                  <span class="pc-filter__l">{% if filter.label contains 'fwerking' %}Dikte{% elsif filter.label == 'Wandpaneel' %}Look{% else %}{{ filter.label }}{% endif %}</span>
                  {%- for key in key_list -%}
                    {%- liquid
                      assign kname = key | remove: '|'
                      assign grp_q = ''
                      assign grp_on = false
                      for v in filter.values
                        assign k = v.label | downcase | remove: ' ' | remove: '(' | remove: ')'
                        if k contains '8mm'
                          assign k = '8 mm naadloos'
                        elsif k contains '5mm'
                          assign k = '5 mm stomp'
                        else
                          assign k = v.label | strip
                        endif
                        if k == kname
                          assign ev = v.value | url_param_escape
                          assign grp_q = grp_q | append: '&' | append: v.param_name | append: '=' | append: ev | append: '¦'
                          if v.active
                            assign grp_on = true
                          endif
                        endif
                      endfor
                      assign q = active_q
                      if grp_on
                        assign q = ''
                        for f2 in collection.filters
                          if f2.type == 'list'
                            for av in f2.active_values
                              assign k2 = av.label | downcase | remove: ' ' | remove: '(' | remove: ')'
                              if k2 contains '8mm'
                                assign k2 = '8 mm naadloos'
                              elsif k2 contains '5mm'
                                assign k2 = '5 mm stomp'
                              else
                                assign k2 = av.label | strip
                              endif
                              unless f2.param_name == filter.param_name and k2 == kname
                                assign ev = av.value | url_param_escape
                                assign q = q | append: '&' | append: av.param_name | append: '=' | append: ev
                              endunless
                            endfor
                          endif
                        endfor
                      else
                        assign q = q | append: grp_q
                      endif
                      assign q = q | remove: '¦'
                    -%}
                    <a rel="nofollow" class="pc-chip{% if grp_on %} is-on{% endif %}" href="{{ collection.url }}?sort_by={{ sort_q }}{{ q }}#decors"{% if grp_on %} aria-current="true"{% endif %}>{{ kname }}</a>
                  {%- endfor -%}
                </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if active_q != blank -%}<a rel="nofollow" class="pc-clear" href="{{ collection.url }}?sort_by={{ sort_q }}#decors">Wis filters</a>{%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.show_sort -%}
          {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
          <label class="pc-sort">
            <span>Sorteren</span>
            <select data-pc-sort aria-label="Sorteren">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
              {%- endfor -%}
            </select>
          </label>
        {%- endif -%}
      </div>

      <h2 class="pc-vh">Overzicht van alle decors</h2>
      <ul class="pc-grid" role="list">
        {%- for p in collection.products -%}
          {%- if pd_hidden contains p.handle -%}{%- continue -%}{%- endif -%}
          {%- liquid
            capture code
              render 'pd-decor', product: p, part: 'code'
            endcapture
            capture name
              render 'pd-decor', product: p, part: 'name'
            endcapture
            capture eyebrow
              render 'pd-decor', product: p, part: 'eyebrow'
            endcapture
            assign code = code | strip
            assign name = name | strip
            assign eyebrow = eyebrow | strip
            assign room = p.media[1] | default: p.featured_image
            assign panel = p.featured_image
            assign v = p.selected_or_first_available_variant
            assign finishes = ''
            assign size = ''
            assign f5 = false
            assign f8 = false
            for o in p.options_with_values
              assign on = o.name | downcase
              if on contains 'afwerking'
                for ov in o.values
                  assign ok = ov | downcase | remove: ' '
                  if ok contains '8mm'
                    assign f8 = true
                  elsif ok contains '5mm'
                    assign f5 = true
                  endif
                endfor
              elsif on contains 'formaat'
                assign size = o.values | last | downcase | remove: 'cm' | remove: ' ' | replace: '×', 'x' | split: 'x' | join: ' × ' | append: ' cm'
              endif
            endfor
            if f5 and f8
              assign finishes = '5 mm stomp of 8 mm naadloos'
            elsif f8
              assign finishes = '8 mm naadloos'
            elsif f5
              assign finishes = '5 mm stomp'
            endif
            capture swatch
              render 'pd-swatch', product: p, width: 240
            endcapture
            capture sw_zoom
              render 'pd-swatch', product: p, part: 'zoom'
            endcapture
            assign label = code | append: ' ' | append: name | strip
            assign alt_room = eyebrow | append: ' wandpaneel ' | append: label | append: ' · sfeerbeeld' | strip
            assign alt_panel = eyebrow | append: ' wandpaneel ' | append: label | append: ' · paneel' | strip
          -%}
          <li class="pc-card">
            <a class="pc-card__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
              {%- if room != blank -%}
                {%- if current_page == 1 and forloop.index <= 4 -%}{%- assign img_load = 'eager' -%}{%- else -%}{%- assign img_load = 'lazy' -%}{%- endif -%}
                {%- if current_page == 1 and forloop.index <= 2 -%}{%- assign img_prio = 'high' -%}{%- else -%}{%- assign img_prio = 'auto' -%}{%- endif -%}
                {{ room | image_url: width: 900 | image_tag: loading: img_load, fetchpriority: img_prio, widths: '360, 540, 720, 900', sizes: '(min-width: 1200px) 23vw, (min-width: 990px) 30vw, 48vw', alt: alt_room, class: 'pc-card__room' }}
              {%- endif -%}
              {%- if room != panel -%}<span class="pc-card__vis">Visualisatie</span>{%- endif -%}
              {%- liquid
                assign pc_pre = true
                for pv in p.variants
                  if pv.available == false or pv.inventory_management == blank or pv.inventory_quantity > 0
                    assign pc_pre = false
                  endif
                endfor
              -%}
              {%- if pc_pre -%}<span class="pc-card__pre">Pre-order</span>{%- endif -%}
              {%- if p.metafields.puredeco.decor_video != blank -%}<span class="pc-card__video">Video</span>{%- endif -%}
              {%- if swatch != blank -%}<span class="pc-card__sw{% if sw_zoom contains '1' %} is-zoom{% endif %}"><img src="{{ swatch | strip }}" alt="" loading="lazy" width="240" height="240"></span>{%- endif -%}
            </a>
            <div class="pc-card__body">
              <p class="pc-card__eyebrow">{{ eyebrow | default: 'Wandpaneel' }}</p>
              <h3 class="pc-card__name"><a href="{{ p.url }}"><span>{{ code }}</span> {{ name }}</a></h3>
              <p class="pc-card__spec">{% if size != blank %}<span class="pc-card__size">{{ size }}</span>{% endif %}{% if finishes != blank %}<span class="pc-card__fin">{{ finishes }}</span>{% endif %}</p>
              <div class="pc-card__foot">
                <p class="pc-card__price">
                  {%- if p.price_varies -%}<span class="pc-card__from">vanaf</span> {% endif -%}
                  <strong>{{ p.price_min | money }}</strong>
                  {%- if p.compare_at_price_max > p.price_min -%} <s>{{ p.compare_at_price_max | money }}</s>{%- endif -%}
                  <span class="pc-card__unit">per paneel</span>
                  {%- capture pc_m2 -%}{%- render 'pd-m2', product: p, part: 'min' -%}{%- endcapture -%}
                  {%- assign pc_m2 = pc_m2 | strip -%}
                  {%- if pc_m2 != blank -%}<span class="pc-card__m2">≈ {{ pc_m2 }} per m²</span>{%- endif -%}
                </p>
                {%- if v and code != blank -%}
                  <button type="button" class="pc-card__smp" data-pc-sample data-id="{{ v.id }}" data-url="{{ p.url }}" data-title="{{ p.title | escape }}" data-label="{{ label | escape }}" data-img="{{ swatch | strip }}" aria-pressed="false" aria-label="Staal van {{ label | escape }} toevoegen">
                    <span class="off">+ Staal</span><span class="on">✓ Staal</span>
                  </button>
                {%- endif -%}
              </div>
            </div>
          </li>
        {%- endfor -%}
      </ul>

      {%- if paginate.pages > 1 -%}
        <nav class="pc-pages" aria-label="Pagina's">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" rel="prev">← Vorige</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" rel="next">Volgende →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ItemList: de producten op deze pagina {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ h1 | json }},
      "url": {{ canonical_url | json }},
      {%- if seo_desc != blank %}"description": {{ seo_desc | json }},{% endif %}
      "mainEntity": {
        "@type": "ItemList",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          {%- for p in collection.products -%}
            { "@type": "ListItem", "position": {{ paginate.current_offset | plus: forloop.index }}, "url": {{ request.origin | append: p.url | json }}, "name": {{ p.title | json }} }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
    }
  </script>
  {%- endpaginate -%}

  {%- comment -%} Samples-balk {%- endcomment -%}
  <div class="pc-toast" data-pc-toast hidden aria-live="polite">
    <span data-pc-toast-t></span>
    <a href="/pages/sample">Bekijk je samples →</a>
  </div>

  {%- comment -%} Tekst over de collectie {%- endcomment -%}
  {%- if seo_body != blank -%}
    {%- if current_page == 1 -%}
      <section class="ph-s pc-guide">
        <div class="ph-wrap">
          <div class="pc-rte pc-guide__in">{{ seo_body }}</div>
        </div>
      </section>
    {%- endif -%}
  {%- elsif body != blank -%}
    <section class="ph-s pc-about">
      <div class="ph-wrap pc-about__in">
        <h2 class="ph-h2">Over {{ h1 | downcase }}</h2>
        <div class="pc-rte">{{ body }}</div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} Veelgestelde vragen (blokken; optioneel per collectie) {%- endcomment -%}
  {%- capture faq_items -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' -%}
        {%- assign only = block.settings.only | strip -%}
        {%- assign show = true -%}
        {%- if only != blank -%}
          {%- assign only_list = only | split: ',' -%}
          {%- assign show = false -%}
          {%- for oh in only_list -%}{%- assign oh2 = oh | strip -%}{%- if oh2 == collection.handle -%}{%- assign show = true -%}{%- endif -%}{%- endfor -%}
        {%- endif -%}
        {%- if show and block.settings.q != blank -%}<!--faq-->{{ block.id }}{%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign faq_ids = faq_items | split: '<!--faq-->' -%}
  {%- if faq_ids.size > 1 -%}
    <section class="ph-s pc-faq">
      <div class="ph-wrap pc-faq__in">
        <h2 class="ph-h2">Veelgestelde vragen</h2>
        <div class="pc-faq__list">
          {%- for block in section.blocks -%}
            {%- if faq_ids contains block.id -%}
              <details class="pc-faq__item" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.q }}</summary>
                <div class="pc-rte">{{ block.settings.a }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign first = true -%}
          {%- for block in section.blocks -%}
            {%- if faq_ids contains block.id -%}
              {% unless first %},{% endunless %}{ "@type": "Question", "name": {{ block.settings.q | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.a | strip_html | json }} } }
              {%- assign first = false -%}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    </script>
  {%- endif -%}

  {%- comment -%} Afsluiter: advies en samples {%- endcomment -%}
  <section class="ph-s pc-end">
    <div class="ph-wrap pc-end__in">
      <div>
        <p class="ph-k ph-k--bronze">Twijfel je tussen decors?</p>
        <p class="ph-h2 pc-end__h">Leg ze naast elkaar, in je eigen licht.</p>
      </div>
      <div class="pc-end__btns">
        <a class="ph-btn ph-btn--ink" href="/pages/sample">Kies gratis samples</a>
        <a class="ph-btn ph-btn--line" href="/pages/showroom">Bezoek de studio in Herwen</a>
      </div>
    </div>
  </section>
</div>

<script>
(function () {
  var root = document.querySelector('[data-pc]');
  if (!root) return;
  var sel = root.querySelector('[data-pc-sort]');
  if (sel) sel.addEventListener('change', function () {
    var u = new URL(window.location.href); u.searchParams.set('sort_by', sel.value); u.searchParams.delete('page'); u.hash = 'decors'; window.location.href = u.toString();
  });
  var KEY = 'pd-edit', MAX = parseInt(root.dataset.max, 10) || 5;
  var toast = root.querySelector('[data-pc-toast]'), tt = root.querySelector('[data-pc-toast-t]'), timer;
  function get() { try { return JSON.parse(localStorage.getItem(KEY) || '[]') || []; } catch (e) { return []; } }
  function put(v) { try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {} }
  var btns = [].slice.call(root.querySelectorAll('[data-pc-sample]'));
  function paint() {
    var c = get();
    btns.forEach(function (b) { var on = c.some(function (x) { return x.id === b.dataset.id; }); b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', on ? 'true' : 'false'); });
  }
  function say(t) { tt.textContent = t; toast.hidden = false; clearTimeout(timer); timer = setTimeout(function () { toast.hidden = true; }, 4000); }
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var c = get(), i = c.findIndex(function (x) { return x.id === b.dataset.id; });
      if (i > -1) { c.splice(i, 1); put(c); paint(); say(b.dataset.label + ' verwijderd · ' + c.length + ' van ' + MAX + ' gekozen'); return; }
      if (c.length >= MAX) { say('Je hebt al ' + MAX + ' samples gekozen'); return; }
      c.push({ id: b.dataset.id, url: b.dataset.url, title: b.dataset.title, label: b.dataset.label, img: b.dataset.img }); put(c); paint();
      say(b.dataset.label + ' toegevoegd · ' + c.length + ' van ' + MAX + ' gekozen');
    });
  });
  paint();
})();
</script>

{% schema %}
{
  "name": "Puredeco collectie",
  "tag": "div",
  "class": "pd-collection-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Regel boven de titel", "default": "Wandpanelen met bamboekern" },
    { "type": "checkbox", "id": "intro_from_text", "label": "Eerste alinea van de collectietekst als intro", "default": true },
    { "type": "checkbox", "id": "hero_visual", "label": "Collectiebeeld is een visualisatie", "default": true },
    { "type": "textarea", "id": "nav", "label": "Collectienavigatie", "info": "Eén per regel: handle|tekst. De tekst is de ankertekst voor Google.", "default": "wandpanelen|Alle wandpanelen\nhout-1|Houten wandpanelen\n8mm-naadloos|Naadloze wandpanelen\njapandi|Japandi wandpanelen\nleer|Leerlook\nkunst|Art\ndoorlopend-marmer|Marmerlook\nakupanelen|Akupanelen\naccessoires|Accessoires" },
    { "type": "range", "id": "per_page", "label": "Producten per pagina", "min": 12, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_filters", "label": "Filters tonen", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Sorteren tonen", "default": true },
    { "type": "range", "id": "sample_max", "label": "Maximaal aantal samples", "min": 1, "max": 6, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Vraag",
      "settings": [
        { "type": "text", "id": "q", "label": "Vraag" },
        { "type": "richtext", "id": "a", "label": "Antwoord" },
        { "type": "text", "id": "only", "label": "Alleen tonen bij collectie(s)", "info": "Handles, komma-gescheiden. Leeg = bij alle collecties." }
      ]
    }
  ],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
