{%- comment -%}
  Puredeco · bovenkant productpagina als één compositie.
  Beeld (Interieur · Specimen · Structuur · Aansluiting · Film) + titel, prijs, Finish, formaat, aantal en koopknop.
  Toevoegen aan winkelmand via het theme-formulier (is="product-form"), dus de winkelmandlade werkt zoals altijd.
{%- endcomment -%}
{%- liquid
  capture pdh_code
    render 'pd-decor', product: product, part: 'code'
  endcapture
  capture pdh_name
    render 'pd-decor', product: product, part: 'name'
  endcapture
  capture pdh_eyebrow
    render 'pd-decor', product: product, part: 'eyebrow'
  endcapture
  assign pdh_code = pdh_code | strip
  assign pdh_name = pdh_name | strip
  assign pdh_eyebrow = pdh_eyebrow | strip
  assign pdh_is_panel = false
  if product.title contains 'Wandpaneel'
    assign pdh_is_panel = true
  endif

  assign pdh_imgs = product.media | where: 'media_type', 'image'
  assign pdh_pack = pdh_imgs.first
  assign pdh_video = product.media | where: 'media_type', 'video' | first
  assign pdh_ext = product.media | where: 'media_type', 'external_video' | first
  assign pdh_interiors = pdh_imgs.size | minus: 1

  assign pdh_variant = product.selected_or_first_available_variant
  assign pdh_form_id = 'pdh-form-' | append: section.id
-%}

<div class="pdh" data-pdh data-section="{{ section.id }}">
  <div class="pdh__grid">

    {%- comment -%} ===== Beeld ===== {%- endcomment -%}
    <div class="pdh__media">
      <div class="pdh__stage" data-pdh-stage>

        {%- if pdh_interiors > 0 -%}
          <div class="pdh__view is-active" data-view="interieur">
            <div class="pdh__strip" data-pdh-strip>
              {%- for m in pdh_imgs offset: 1 -%}
                {%- liquid
                  assign ld = 'lazy'
                  if forloop.first
                    assign ld = 'eager'
                  endif
                -%}
                <figure class="pdh__slide">
                  {{ m | image_url: width: 2400 | image_tag:
                    loading: ld,
                    widths: '750, 1100, 1500, 1900, 2400',
                    sizes: '(min-width: 1100px) 60vw, 100vw',
                    alt: m.alt | default: pdh_name
                  }}
                </figure>
              {%- endfor -%}
            </div>
            {%- if pdh_interiors > 1 -%}
              <div class="pdh__stripnav">
                <button type="button" data-pdh-prev aria-label="Vorige foto">←</button>
                <span data-pdh-count>1 / {{ pdh_interiors }}</span>
                <button type="button" data-pdh-next aria-label="Volgende foto">→</button>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if pdh_pack -%}
          <div class="pdh__view{% if pdh_interiors == 0 %} is-active{% endif %}" data-view="specimen">
            <div class="pdh__specimen">
              {{ pdh_pack | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 1100px) 50vw, 100vw', alt: pdh_name }}
            </div>
            <p class="pdh__caption">{% if pdh_code != blank %}{{ pdh_code }} · {% endif %}{{ pdh_name }} · één paneel</p>
          </div>

          {%- assign pdh_tex = pdh_pack | image_url: width: 2400 -%}
          <div class="pdh__view" data-view="structuur">
            <div class="pdh__texture pdh__texture--close" style="background-image: url('{{ pdh_tex }}');" role="img" aria-label="Structuur van {{ pdh_name }} van dichtbij"></div>
            <p class="pdh__caption">Structuur van dichtbij · uit de productfoto</p>
          </div>

          <div class="pdh__view" data-view="aansluiting">
            <div class="pdh__joint" data-pdh-joint>
              <div class="pdh__texture pdh__texture--joint" style="background-image: url('{{ pdh_tex }}');"></div>
              <div class="pdh__texture pdh__texture--joint pdh__texture--b" style="background-image: url('{{ pdh_tex }}');"></div>
              <span class="pdh__seam" aria-hidden="true"></span>
            </div>
            <p class="pdh__caption" data-pdh-joint-caption>Signature · naadloos op een vlakke, rechte ondergrond</p>
          </div>
        {%- endif -%}

        {%- if pdh_video or pdh_ext or section.settings.video != blank -%}
          <div class="pdh__view" data-view="film">
            {%- if section.settings.video != blank -%}
              {{ section.settings.video | video_tag: controls: true, muted: true, playsinline: true, loop: true, preload: 'none', image_size: '1600x' }}
            {%- elsif pdh_video -%}
              {{ pdh_video | video_tag: controls: true, muted: true, playsinline: true, loop: true, preload: 'none', image_size: '1600x' }}
            {%- else -%}
              {{ pdh_ext | external_video_tag: loading: 'lazy' }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <nav class="pdh__views" aria-label="Bekijk {{ pdh_name }}">
        {%- if pdh_interiors > 0 -%}<button type="button" class="is-active" data-pdh-view="interieur">Interieur</button>{%- endif -%}
        {%- if pdh_pack -%}
          <button type="button"{% if pdh_interiors == 0 %} class="is-active"{% endif %} data-pdh-view="specimen">Paneel</button>
          <button type="button" data-pdh-view="structuur">Structuur</button>
          <button type="button" data-pdh-view="aansluiting">Aansluiting</button>
        {%- endif -%}
        {%- if pdh_video or pdh_ext or section.settings.video != blank -%}<button type="button" data-pdh-view="film">Film</button>{%- endif -%}
      </nav>
    </div>

    {%- comment -%} ===== Koopkolom ===== {%- endcomment -%}
    <div class="pdh__info">
      <div class="pdh__inner">
        <header class="pdh__head">
          <p class="pdh__eyebrow">
            {%- if pdh_eyebrow != blank -%}<span>{{ pdh_eyebrow }}</span>{%- endif -%}
            {%- if pdh_eyebrow != blank and pdh_code != blank -%}<span class="pdh__dot" aria-hidden="true"></span>{%- endif -%}
            {%- if pdh_code != blank -%}<span>{{ pdh_code }}</span>{%- endif -%}
          </p>
          <h1 class="pdh__title">{% if pdh_code != blank %}<span class="visually-hidden">Wandpaneel {{ pdh_code }} </span>{% endif %}{{ pdh_name }}</h1>
          {%- assign pdh_rating = product.metafields.reviews.rating.value -%}
          {%- assign pdh_rcount = product.metafields.reviews.rating_count.value | default: 0 -%}
          {%- if pdh_rating != blank and pdh_rcount > 0 -%}
            {%- assign pdh_pct = pdh_rating.rating | divided_by: pdh_rating.scale_max | times: 100.0 -%}
            <a class="pdh__rating" href="#judgeme_product_reviews" aria-label="Beoordeeld met {{ pdh_rating.rating | round: 1 }} van de {{ pdh_rating.scale_max }}, {{ pdh_rcount }} reviews">
              <span class="pdh__stars" style="--pct: {{ pdh_pct }}%" aria-hidden="true">★★★★★</span>
              <span>{{ pdh_rating.rating | round: 1 | replace: '.', ',' }}</span>
              <span class="pdh__rating-n">· {{ pdh_rcount }} {% if pdh_rcount == 1 %}review{% else %}reviews{% endif %}</span>
            </a>
          {%- endif -%}
          {%- if pdh_is_panel -%}
            <p class="pdh__intro">{{ product.metafields.custom.intro | default: 'Op een kern van bamboe: stevig, vormvast en gemaakt om te blijven.' }}</p>
          {%- endif -%}
        </header>

        <div class="pdh__price" aria-live="polite">
          <span class="pdh__amount" data-pdh-price>{{ pdh_variant.price | money }}</span>
          <s class="pdh__compare" data-pdh-compare{% unless pdh_variant.compare_at_price > pdh_variant.price %} hidden{% endunless %}>{{ pdh_variant.compare_at_price | money }}</s>
          <span class="pdh__unit" data-pdh-unit>per paneel</span>
        </div>

        {%- form 'product', product, id: pdh_form_id, class: 'pdh__form', novalidate: 'novalidate', data-type: 'add-to-cart-form', is: 'product-form' -%}
          <input type="hidden" name="id" value="{{ pdh_variant.id }}" data-pdh-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign pdh_is_finish = false
                for v in option.values
                  assign k = v | downcase | remove: ' ' | slice: 0, 3
                  if k == '8mm' or k == '5mm'
                    assign pdh_is_finish = true
                  endif
                endfor
              -%}
              {%- if pdh_is_finish -%}
                <fieldset class="pdh__opt pdh__opt--finish" data-pdh-option="{{ forloop.index0 }}">
                  <legend class="pdh__label">Finish</legend>
                  <div class="pdh__finishes">
                                        {%- for pass in (1..2) -%}
                      {%- for v in option.values -%}
                        {%- assign k = v | downcase | remove: ' ' | slice: 0, 3 -%}
                        {%- liquid
                          assign show = false
                          if pass == 1 and k == '8mm'
                            assign show = true
                          endif
                          if pass == 2 and k != '8mm'
                            assign show = true
                          endif
                        -%}
                        {%- if show -%}
                          {%- liquid
                            if k == '8mm'
                              assign fn = 'Signature'
                              assign fs = '8 mm · kliksysteem · naadloos*'
                              assign fd = 'Eén doorlopende wand, zonder zichtbare naad.'
                              assign fk = 'sig'
                            else
                              assign fn = 'Linea'
                              assign fs = '5 mm · stompe aansluiting · zichtbare naad'
                              assign fd = 'Standaarduitvoering, geschikt voor badkamer en keuken.'
                              assign fk = 'lin'
                            endif
                          -%}
                          <label class="pdh__finish" data-finish="{{ fk }}">
                            <input type="radio" name="pdh-o{{ forloop.parentloop.parentloop.index0 }}" value="{{ v | escape }}"{% if v.selected %} checked{% endif %}>
                            <span class="pdh__finish-swatch" style="background-image: url('{{ pdh_pack | image_url: width: 800 }}');" aria-hidden="true"><i></i></span>
                            <span class="pdh__finish-text">
                              {%- if fk == 'sig' -%}<span class="pdh__finish-badge">Ons paradepaardje</span>{%- endif -%}
                              <span class="pdh__finish-name">{{ fn }}</span>
                              <span class="pdh__finish-spec">{{ fs }}</span>
                              <span class="pdh__finish-desc">{{ fd }}</span>
                            </span>
                          </label>
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endfor -%}
                  </div>
                  <p class="pdh__finish-note">* Naadloos op een vlakke, rechte ondergrond. Hoe vlakker de wand, hoe strakker het resultaat.</p>
                </fieldset>
              {%- else -%}
                <fieldset class="pdh__opt" data-pdh-option="{{ forloop.index0 }}">
                  <legend class="pdh__label">{{ option.name }}</legend>
                  <div class="pdh__segs">
                    {%- for v in option.values -%}
                      <label class="pdh__seg">
                        <input type="radio" name="pdh-o{{ forloop.parentloop.index0 }}" value="{{ v | escape }}"{% if v.selected %} checked{% endif %}>
                        {%- assign oname = option.name | downcase -%}
                        <span>{% if oname contains 'formaat' or oname contains 'afmeting' %}{{ v | replace: ' cm x ', ' × ' | replace: 'x', ' × ' | replace: '  ', ' ' }}{% else %}{{ v }}{% endif %}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                  <p class="pdh__finish-note">* Naadloos op een vlakke, rechte ondergrond. Hoe vlakker de wand, hoe strakker het resultaat.</p>
                </fieldset>
              {%- endif -%}
            {%- endfor -%}
          {%- endunless -%}

          {%- if pdh_is_panel -%}
            <div class="pdc" data-pdc data-price="{{ pdh_variant.price }}" data-options="{{ pdh_variant.options | join: ' ' | escape }}" style="--pdc-tex: url('{{ pdh_pack | image_url: width: 1600 }}');">
              <div class="pdc__head">
                <span class="pdh__label">Jouw wand</span>
                <span class="pdc__hint">Meet van hoek tot hoek, in meters</span>
              </div>
              <div class="pdc__tabs" data-pdc-tabs role="tablist" aria-label="Wanden"></div>
              <div class="pdc__fields">
                <label class="pdc__field">
                  <span class="pdc__flabel">Breedte</span>
                  <span class="pdc__input"><input type="text" inputmode="decimal" autocomplete="off" placeholder="4,20" data-pdc-w aria-label="Breedte van de wand in meter"><em>m</em></span>
                </label>
                <label class="pdc__field">
                  <span class="pdc__flabel">Hoogte</span>
                  <span class="pdc__input"><input type="text" inputmode="decimal" autocomplete="off" placeholder="2,60" data-pdc-h aria-label="Hoogte van de wand in meter"><em>m</em></span>
                </label>
              </div>
              <div class="pdc__preview" aria-hidden="true">
                <div class="pdc__stage">
                  <div class="pdc__wall" data-pdc-wall></div>
                  <span class="pdc__dim pdc__dim--w" data-pdc-dw></span>
                  <span class="pdc__dim pdc__dim--h" data-pdc-dh></span>
                </div>
              </div>
              <dl class="pdc__stats">
                <div><dt>Panelen</dt><dd data-pdc-n>–</dd></div>
                <div><dt>Oppervlak</dt><dd data-pdc-m2>–</dd></div>
                <div><dt>Totaal</dt><dd data-pdc-sum>–</dd></div>
              </dl>
              <p class="pdc__note" data-pdc-note aria-live="polite">Vul de maat van je wand in. We rekenen per wand met hele panelen en zetten het aantal klaar in je bestelling.</p>
              <div class="pdc__ship" data-pdc-ship hidden>
                <span data-pdc-shiptext></span>
                <i><b data-pdc-shipbar></b></i>
              </div>
            </div>
          {%- endif -%}

          <div class="pdh__buy">
            <div class="pdh__qty">
              <button type="button" data-pdh-minus aria-label="Eén minder">−</button>
              <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-pdh-qty aria-label="Aantal panelen">
              <button type="button" data-pdh-plus aria-label="Eén meer">+</button>
            </div>
            <button type="submit" name="add" class="pdh__cta" data-pdh-cta{% unless pdh_variant.available %} disabled{% endunless %}>
              <span class="btn__text" data-pdh-cta-text>{% if pdh_variant.available %}In winkelmand{% else %}Niet beschikbaar{% endif %}</span>
              <span class="pdh__cta-total" data-pdh-total>{{ pdh_variant.price | money }}</span>
            </button>
          </div>
          <div class="product-form__error-message pdh__error" role="alert" hidden></div>
        {%- endform -%}

        <p class="pdh__error" data-pdh-error hidden></p>
        <p class="pdh__klarna">Of betaal in 3 renteloze termijnen van <strong data-pdh-klarna>{{ pdh_variant.price | divided_by: 3 | money }}</strong> met <span class="pdh__klarna-logo">Klarna.</span></p>

        <a class="pdh__sample" href="/pages/sample">
          <span>Eerst voelen? Vraag een gratis sample aan</span>
          <span aria-hidden="true">→</span>
        </a>

        <ul class="pdh__usps">
          <li class="pdh__usp pdh__usp--lead" data-pdh-meta>Op voorraad · geleverd in 3–6 werkdagen</li>
          <li class="pdh__usp">Gratis bezorgd in Nederland vanaf € 600</li>
          <li class="pdh__usp">30 dagen bedenktijd</li>
          <li class="pdh__usp">3 jaar garantie op de panelen</li>
        </ul>

        {%- if shop.enabled_payment_types.size > 0 -%}
          <div class="pdh__pay" aria-label="Betaalmethodes">
            <span class="pdh__pay-label">Veilig betalen met</span>
            <ul class="pdh__pay-list" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'pdh__pay-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- capture pdh_wa_text -%}Hallo Puredeco, ik heb een vraag over {% if pdh_code != blank %}{{ pdh_code }} {% endif %}{{ pdh_name }}.{%- endcapture -%}
        <div class="pdh__advice">
          <span class="pdh__advice-k">Persoonlijk advies · ma–za 10–16 uur</span>
          <div class="pdh__advice-actions">
            <a class="pdh__wa" href="https://wa.me/31316700214?text={{ pdh_wa_text | url_encode }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91A9.85 9.85 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.24 8.24 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24a8.2 8.2 0 0 1 8.24 8.25c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.14.16-.29.18-.54.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.23.25-.87.85-.87 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.22-.16-.47-.28Z"/></svg>
              <span>WhatsApp ons</span>
            </a>
            <a class="pdh__tel" href="tel:+31316700214">Bel 0316 700 214</a>
          </div>
        </div>

        {%- if pdh_is_panel -%}
          <div class="pdh__rows">
            {%- assign pdh_prof = all_products['eindprofielen'] -%}
            {%- if pdh_prof != blank -%}
              <a class="pdh__row" href="{{ pdh_prof.url }}">
                <span class="pdh__row-sw" aria-hidden="true"><i style="background:#3A3A3A"></i><i style="background:#151413"></i><i style="background:#F2F0EB"></i><i style="background:#A07850"></i><i style="background:#C9A55C"></i></span>
                <span><span class="pdh__row-k">Maak de wand af</span>Eindprofielen in vijf kleuren</span>
                <span class="pdh__row-end">vanaf {{ pdh_prof.price_min | money }}</span>
              </a>
            {%- endif -%}
            <a class="pdh__row" href="/pages/form">
              <span class="pdh__row-sw pdh__row-sw--blank" aria-hidden="true"></span>
              <span><span class="pdh__row-k">Puredeco Projects</span>Projectprijs, en vanaf 150 m² je eigen kleur</span>
              <span class="pdh__row-end">Offerte →</span>
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="pdh__bar" data-pdh-bar aria-hidden="true">
    <span class="pdh__bar-name">{% if pdh_code != blank %}<span>{{ pdh_code }}</span> {% endif %}{{ pdh_name }}</span>
    <span class="pdh__bar-price" data-pdh-bar-price>{{ pdh_variant.price | money }}</span>
    <button type="submit" form="{{ pdh_form_id }}" class="pdh__bar-cta" tabindex="-1">In winkelmand</button>
  </div>

  <script type="application/json" data-pdh-variants>
    [{%- for v in product.variants -%}{"id":{{ v.id }},"options":{{ v.options | json }},"price":{{ v.price }},"compare":{{ v.compare_at_price | default: 0 }},"available":{{ v.available | json }},"stock":{% if v.inventory_management == blank or v.inventory_quantity > 0 or v.inventory_policy == 'continue' %}true{% else %}false{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
  </script>
</div>

<script>
/* Puredeco calculator · werkt zelfstandig; luistert naar variantwissels van de productsectie */
(function () {
  var root = document.querySelector('[data-pdh][data-section="{{ section.id }}"]');
  var pdc = root && root.querySelector('[data-pdc]');
  if (!pdc || pdc.dataset.ready) return;
  pdc.dataset.ready = '1';
  try {
  var qtyIn = root.querySelector('[data-pdh-qty]');
  var money = function (c) { return (c / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' }); };
  var current = { price: Number(pdc.getAttribute('data-price')) || 0, options: [pdc.getAttribute('data-options') || ''] };
  function dims(v) {
    var m = v.options.join(' ').match(/(\d{3})\s*(?:cm)?\s*[x×]\s*(\d{2,3})/i);
    return m ? { h: Number(m[1]) / 100, w: Number(m[2]) / 100 } : null;
  }
  function finishKey(v) {
    var t = v.options.join(' ').toLowerCase().replace(/\s/g, '');
    return t.indexOf('8mm') > -1 ? 'sig' : (t.indexOf('5mm') > -1 ? 'lin' : null);
  }
  function total() {
    var q = Math.max(1, parseInt(qtyIn.value, 10) || 1);
    var el = root.querySelector('[data-pdh-total]');
    if (el && current.price) el.textContent = money(current.price * q);
    var kl = root.querySelector('[data-pdh-klarna]');
    if (kl && current.price) kl.textContent = money(Math.ceil(current.price * q / 3));
  }
  var walls = [{ w: '4,20', h: '2,60', example: true }], active = 0;
  function num(v) { var n = parseFloat(String(v).replace(',', '.')); return n > 0 ? n : 0; }
  function fmt(n, d) { return n.toFixed(d).replace('.', ','); }
  /* De calculator rekent altijd met panelen van 280 cm lang. */
  function panel() { var d = dims(current); return { h: 2.8, w: (d && d.w) || 1.22 }; }
  function wallCalc(wl, d) {
    var W = num(wl.w), H = num(wl.h);
    if (!W || !H) return null;
    var cols = Math.ceil(W / d.w - 1e-9), rows = Math.ceil(H / d.h - 1e-9);
    return { W: W, H: H, cols: cols, rows: rows, n: cols * rows, rest: cols * d.w - W };
  }
  function drawTabs() {
    var tabs = pdc.querySelector('[data-pdc-tabs]');
    var d = panel();
    var html = '';
    walls.forEach(function (wl, i) {
      var r = wallCalc(wl, d);
      html += '<button type="button" role="tab" aria-selected="' + (i === active) + '" class="pdc__tab' + (i === active ? ' is-active' : '') + '" data-i="' + i + '">Wand ' + (i + 1) + (r ? ' <span>' + r.n + '</span>' : '') + '</button>';
    });
    if (walls.length > 1) html += '<button type="button" class="pdc__remove" data-pdc-remove aria-label="Wand ' + (active + 1) + ' verwijderen">Verwijder wand ' + (active + 1) + '</button>';
    if (walls.length < 6) html += '<button type="button" class="pdc__add" data-pdc-add>+ Wand toevoegen</button>';
    tabs.innerHTML = html;
  }
  function drawWall(r, d, fk) {
    var wall = pdc.querySelector('[data-pdc-wall]');
    var dw = pdc.querySelector('[data-pdc-dw]'), dh = pdc.querySelector('[data-pdc-dh]');
    var W = r ? r.W : 4.2, H = r ? r.H : 2.6;
    var ratio = Math.max(0.5, Math.min(4, W / H));
    wall.style.aspectRatio = ratio;
    wall.classList.toggle('is-empty', !r);
    var cols = Math.ceil(W / d.w - 1e-9), html = '';
    for (var c = 0; c < cols; c++) {
      var left = (c * d.w / W) * 100, width = (d.w / W) * 100;
      html += '<i style="left:' + left + '%;width:' + width + '%;background-position:' + (38 + (c % 5) * 6) + '% ' + (30 + (c % 3) * 15) + '%"></i>';
    }
    if (H > d.h) html += '<b class="pdc__hseam" style="bottom:' + (d.h / H * 100) + '%"></b>';
    wall.innerHTML = html;
    wall.setAttribute('data-finish', fk || '');
    dw.textContent = fmt(W, 2) + ' m';
    dh.textContent = fmt(H, 2) + ' m';
  }
  function calc(fromInput) {
    if (!pdc || !current) return;
    var d = panel();
    var fk = finishKey(current);
    var n = 0, m2 = 0, tooHigh = false, filled = 0;
    walls.forEach(function (wl) {
      var r = wallCalc(wl, d);
      if (r) { n += r.n; m2 += r.W * r.H; filled++; if (r.H > d.h) tooHigh = true; }
    });
    var isExample = walls.length === 1 && walls[0].example;
    pdc.classList.toggle('is-example', isExample);
    var r0 = wallCalc(walls[active], d);
    drawWall(r0, d, fk);
    drawTabs();
    var nEl = pdc.querySelector('[data-pdc-n]'), mEl = pdc.querySelector('[data-pdc-m2]'), sEl = pdc.querySelector('[data-pdc-sum]');
    var note = pdc.querySelector('[data-pdc-note]'), ship = pdc.querySelector('[data-pdc-ship]');
    if (!n) {
      nEl.textContent = '–'; mEl.textContent = '–'; sEl.textContent = '–';
      note.textContent = 'Vul de maat van je wand in. We rekenen per wand met hele panelen en zetten het aantal klaar in je bestelling.';
      ship.hidden = true;
      return;
    }
    var sum = n * current.price;
    nEl.textContent = n;
    mEl.textContent = fmt(m2, 1) + ' m²';
    sEl.textContent = money(sum);
    if (fromInput === true && !isExample) { qtyIn.value = n; total(); }
    var msg = isExample
      ? 'Voorbeeld voor een wand van 4,20 × 2,60 m. Vul jouw maten in; het aantal panelen gaat dan vanzelf naar je bestelling.'
      : n + (n === 1 ? ' paneel' : ' panelen') + ' van ' + fmt(d.w * 100, 0) + ' × ' + fmt(d.h * 100, 0) + ' cm staan klaar in je bestelling.';
    if (!isExample && r0 && r0.rest > 0.005) msg += ' Op wand ' + (active + 1) + ' houd je ' + fmt(r0.rest * 100, 0) + ' cm over voor hoeken en randen.';
    if (tooHigh) msg += ' Een wand hoger dan ' + fmt(d.h, 2) + ' m krijgt een horizontale naad; we denken graag mee.';
    note.textContent = msg;
    var rest = 60000 - sum;
    ship.hidden = false;
    pdc.querySelector('[data-pdc-shiptext]').textContent = rest > 0 ? 'Nog ' + money(rest) + ' tot gratis bezorging in Nederland' : 'Gratis bezorgd in Nederland';
    pdc.querySelector('[data-pdc-shipbar]').style.width = Math.min(100, sum / 60000 * 100) + '%';
  }
  if (pdc) {
    var wIn = pdc.querySelector('[data-pdc-w]'), hIn = pdc.querySelector('[data-pdc-h]');
    var sync = function () { wIn.value = walls[active].w; hIn.value = walls[active].h; };
    var onEdit = function () { if (wIn.value === walls[active].w && hIn.value === walls[active].h) return; walls[active].w = wIn.value; walls[active].h = hIn.value; walls[active].example = false; calc(true); };
    ['input', 'change', 'keyup'].forEach(function (ev) { wIn.addEventListener(ev, onEdit); hIn.addEventListener(ev, onEdit); });
    [wIn, hIn].forEach(function (el) {
      el.addEventListener('focus', function () { if (walls[active].example) { el.select(); } });
      el.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); el.blur(); } });
    });
    sync();
    pdc.querySelector('[data-pdc-tabs]').addEventListener('click', function (e) {
      var b = e.target.closest('button');
      if (!b) return;
      if (b.hasAttribute('data-pdc-add')) { walls.push({ w: '', h: walls[active].h }); active = walls.length - 1; }
      else if (b.hasAttribute('data-pdc-remove')) { walls.splice(active, 1); active = Math.max(0, active - 1); }
      else { active = Number(b.getAttribute('data-i')); }
      walls.forEach(function (w) { w.example = false; });
      sync(); calc(true); wIn.focus();
    });
  }

  root.addEventListener('pdh:variant', function (e) { current = e.detail; calc(true); });
  calc(true);
  } catch (err) {
    console.error('Puredeco calculator', err);
    var n = pdc.querySelector('[data-pdc-note]');
    if (n) n.textContent = 'Technische melding (alleen zichtbaar in test): ' + err.message;
  }
})();
</script>

<script type="application/ld+json">{{ product | structured_data }}</script>

<script>
(function () {
  var root = document.querySelector('[data-pdh][data-section="{{ section.id }}"]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  try {
  var variants = JSON.parse(root.querySelector('[data-pdh-variants]').textContent);
  var form = root.querySelector('form');
  var idIn = root.querySelector('[data-pdh-id]');
  var qtyIn = root.querySelector('[data-pdh-qty]');
  var money = function (c) { return (c / 100).toLocaleString('nl-NL', { style: 'currency', currency: 'EUR' }); };
  var current = null;

  /* ---- Beeld: weergaven ---- */
  var views = root.querySelectorAll('[data-view]');
  root.querySelectorAll('[data-pdh-view]').forEach(function (b) {
    b.addEventListener('click', function () {
      var k = b.getAttribute('data-pdh-view');
      root.querySelectorAll('[data-pdh-view]').forEach(function (x) { x.classList.toggle('is-active', x === b); });
      views.forEach(function (v) {
        var on = v.getAttribute('data-view') === k;
        v.classList.toggle('is-active', on);
        var vid = v.querySelector('video');
        if (vid) { if (on) { vid.play && vid.play().catch(function () {}); } else { vid.pause && vid.pause(); } }
      });
    });
  });
  var strip = root.querySelector('[data-pdh-strip]');
  if (strip) {
    var count = root.querySelector('[data-pdh-count]');
    var slideCount = strip.children.length;
    var at = function () { return Math.round(strip.scrollLeft / strip.clientWidth); };
    var go = function (d) { strip.scrollTo({ left: (at() + d) * strip.clientWidth, behavior: 'smooth' }); };
    var prev = root.querySelector('[data-pdh-prev]'), next = root.querySelector('[data-pdh-next]');
    prev && prev.addEventListener('click', function () { go(-1); });
    next && next.addEventListener('click', function () { go(1); });
    strip.addEventListener('scroll', function () { if (count) count.textContent = Math.min(at() + 1, slideCount) + ' / ' + slideCount; }, { passive: true });
  }

  /* ---- Varianten ---- */
  var fieldsets = root.querySelectorAll('[data-pdh-option]');
  function selected() {
    var o = [];
    fieldsets.forEach(function (f) {
      var c = f.querySelector('input:checked');
      o[Number(f.getAttribute('data-pdh-option'))] = c ? c.value : null;
    });
    return o;
  }
  function match(opts, changedIdx) {
    var exact = variants.find(function (v) { return v.options.every(function (x, i) { return opts[i] == null || opts[i] === x; }); });
    if (exact) return exact;
    var fallback = variants.find(function (v) { return changedIdx == null || v.options[changedIdx] === opts[changedIdx]; });
    return fallback || variants[0];
  }
  function dims(v) {
    var m = v.options.join(' ').match(/(\d{3})\s*(?:cm)?\s*[x×]\s*(\d{2,3})/i);
    return m ? { h: Number(m[1]) / 100, w: Number(m[2]) / 100 } : null;
  }
  function finishKey(v) {
    var t = v.options.join(' ').toLowerCase().replace(/\s/g, '');
    return t.indexOf('8mm') > -1 ? 'sig' : (t.indexOf('5mm') > -1 ? 'lin' : null);
  }
  function render(v, push) {
    current = v;
    idIn.value = v.id;
    fieldsets.forEach(function (f) {
      var i = Number(f.getAttribute('data-pdh-option'));
      f.querySelectorAll('input').forEach(function (inp) { inp.checked = inp.value === v.options[i]; });
    });
    root.querySelector('[data-pdh-price]').textContent = money(v.price);
    var cmp = root.querySelector('[data-pdh-compare]');
    if (v.compare > v.price) { cmp.hidden = false; cmp.textContent = money(v.compare); } else { cmp.hidden = true; }
    var d = dims(v);
    root.querySelector('[data-pdh-unit]').textContent = 'per paneel' + (d ? ' · ' + String(Math.round(d.h * 100)) + ' × ' + String(Math.round(d.w * 100)) + ' cm · ' + money(Math.round(v.price / (d.h * d.w))) + ' per m²' : '');
    var cta = root.querySelector('[data-pdh-cta]');
    cta.disabled = !v.available;
    root.querySelector('[data-pdh-cta-text]').textContent = v.available ? 'In winkelmand' : 'Niet beschikbaar';
    root.querySelector('[data-pdh-bar-price]').textContent = money(v.price);
    var meta = root.querySelector('[data-pdh-meta]');
    meta.textContent = v.stock ? 'Op voorraad · ' + deliveryWindow() : 'Op bestelling · levertijd tot 10 weken, we bevestigen de datum';
    var fk = finishKey(v);
    root.setAttribute('data-finish', fk || '');
    var cap = root.querySelector('[data-pdh-joint-caption]');
    if (cap) cap.textContent = fk === 'lin' ? 'Linea · stompe aansluiting, de naad blijft zichtbaar' : 'Signature · naadloos op een vlakke, rechte ondergrond';
    total();
    root.dispatchEvent(new CustomEvent('pdh:variant', { detail: { price: v.price, options: v.options } }));
    if (push) {
      var u = new URL(location.href);
      u.searchParams.set('variant', v.id);
      history.replaceState(null, '', u.toString());
    }
  }
  function total() {
    if (!current) return;
    var q = Math.max(1, parseInt(qtyIn.value, 10) || 1);
    root.querySelector('[data-pdh-total]').textContent = money(current.price * q);
    var kl = root.querySelector('[data-pdh-klarna]');
    if (kl) kl.textContent = money(Math.ceil(current.price * q / 3));
  }
  function deliveryWindow() {
    var add = function (n) {
      var d = new Date(); var c = 0;
      while (c < n) { d.setDate(d.getDate() + 1); var w = d.getDay(); if (w !== 0 && w !== 6) c++; }
      return d;
    };
    var f = function (d) { return d.toLocaleDateString('nl-NL', { weekday: 'short', day: 'numeric', month: 'short' }).replace('.', ''); };
    return 'bestel vandaag, in huis tussen ' + f(add(3)) + ' en ' + f(add(6));
  }
  fieldsets.forEach(function (f) {
    f.addEventListener('change', function () {
      render(match(selected(), Number(f.getAttribute('data-pdh-option'))), true);
    });
  });
  root.querySelector('[data-pdh-minus]').addEventListener('click', function () { qtyIn.value = Math.max(1, (parseInt(qtyIn.value, 10) || 1) - 1); total(); });
  root.querySelector('[data-pdh-plus]').addEventListener('click', function () { qtyIn.value = (parseInt(qtyIn.value, 10) || 1) + 1; total(); });
  qtyIn.addEventListener('input', total);

  /* ---- Start: Signature standaard als er geen variant in de URL staat ---- */
  var params = new URLSearchParams(location.search);
  var start = variants.find(function (v) { return String(v.id) === params.get('variant'); });
  if (!start) {
    start = variants.find(function (v) { return v.id === Number(idIn.value); }) || variants[0];
    if (finishKey(start) === 'lin') {
      var sig = variants.find(function (v) {
        return finishKey(v) === 'sig' && v.available && v.options.every(function (x, i) { var t = x.toLowerCase().replace(/\s/g, ''); return t.indexOf('mm') > -1 || x === start.options[i]; });
      }) || variants.find(function (v) { return finishKey(v) === 'sig' && v.available; });
      if (sig) start = sig;
    }
    /* Standaard het formaat van 280 cm, binnen dezelfde Finish */
    if (start.options.join(' ').indexOf('280') === -1) {
      var f280 = variants.find(function (v) { return v.available && finishKey(v) === finishKey(start) && v.options.join(' ').indexOf('280') > -1; });
      if (f280) start = f280;
    }
  }
  render(start, false);

  /* ---- Vaste koopbalk zodra de koopknop uit beeld is ---- */
  var bar = root.querySelector('[data-pdh-bar]');
  var cta = root.querySelector('[data-pdh-cta]');
  if ('IntersectionObserver' in window && bar && cta) {
    new IntersectionObserver(function (e) {
      var show = !e[0].isIntersecting && e[0].boundingClientRect.top < 0;
      bar.classList.toggle('is-on', show);
      bar.setAttribute('aria-hidden', show ? 'false' : 'true');
      bar.querySelector('button').tabIndex = show ? 0 : -1;
    }).observe(cta);
  }
  } catch (err) {
    console.error('Puredeco product', err);
    var n = root.querySelector('[data-pdh-error]');
    if (n) { n.hidden = false; n.textContent = 'Technische melding (alleen zichtbaar in test): ' + err.message; }
  }
})();
</script>

