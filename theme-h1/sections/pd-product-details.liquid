{%- comment -%}
  Puredeco · productverhaal onder de koopkolom, volgens het ontwerp "The Puredeco Finish".
  Keuzehulp Signature/Linea · montage · alles over het decor · interieur · meer uit de collectie · vragen · Studio Herwen.
{%- endcomment -%}
{%- liquid
  capture pd_code
    render 'pd-decor', product: product, part: 'code'
  endcapture
  capture pd_full
    render 'pd-decor', product: product, part: 'full'
  endcapture
  assign pd_ref = pd_code | default: pd_full

  assign pd_has_sig = false
  assign pd_has_lin = false
  assign pd_formats = ''
  for option in product.options_with_values
    for value in option.values
      assign key = value | downcase | remove: ' ' | slice: 0, 3
      if key == '8mm'
        assign pd_has_sig = true
      elsif key == '5mm'
        assign pd_has_lin = true
      endif
    endfor
    assign oname = option.name | downcase
    if oname == 'formaat' or oname == 'afmeting'
      assign pd_formats = option.values | join: ' · '
    endif
  endfor
  if pd_has_sig == false and pd_has_lin == false
    if product.title contains '8 mm'
      assign pd_has_sig = true
    else
      assign pd_has_lin = true
    endif
  endif
  assign pd_variant = product.selected_or_first_available_variant
-%}

<div class="pd-story">

  {%- comment -%} 1 · Keuzehulp {%- endcomment -%}
  <section class="pd-s pd-choice" data-pd-choice>
    <div class="pd-wrap">
      <div class="pd-choice__top">
        <h2 class="pd-h2">Welke Puredeco Finish past bij jouw wand?</h2>
        <div class="pd-choice__toggle" role="group" aria-label="Kies wat je zoekt">
          <button type="button" class="is-active" data-pd-pick="sig">Ik wil één rustig vlak</button>
          <button type="button" data-pd-pick="lin">Een zichtbare naad is prima</button>
        </div>
      </div>
      <div class="pd-choice__cards">
        <article class="pd-card is-active" data-pd-card="sig">
          <header class="pd-card__head"><h3 class="pd-card__name">Signature <em class="pd-card__badge">Ons paradepaardje</em></h3><span>8 mm · klik</span></header>
          <div class="pd-xsvg" aria-hidden="true"><svg viewBox="0 0 316 64"><rect x="16" y="22" width="248" height="3.5" fill="#7A4F36"/><g fill="none" stroke="#151413" stroke-width="1" stroke-linejoin="round"><path d="M16 22 H140 V28 H150 V36 H140 V42 H16 Z"/><path d="M140 22 H264 V42 H140 V36 H150 V28 H140"/></g><g stroke="#151413" stroke-width="0.8"><line x1="278" y1="22" x2="278" y2="42"/><line x1="274" y1="22" x2="282" y2="22"/><line x1="274" y1="42" x2="282" y2="42"/></g><text x="286" y="35" font-size="9" fill="#151413">8 mm</text><text x="140" y="58" font-size="8" fill="#6E675E" text-anchor="middle" letter-spacing="1.5">KLIK · NAADLOOS</text></svg></div>
          <p class="pd-card__small">Doorsnede: toplaag · gerecycled PVC · bamboekern · onderlaag. De klikverbinding trekt de panelen naadloos tegen elkaar.</p>
          <dl class="pd-card__rows">
            <dt>Uitstraling</dt><dd>Naadloos: één doorlopende wand, zonder zichtbare naad*</dd>
            <dt>Montage</dt><dd>Panelen klikken in elkaar, op een vlakke, egale wand</dd>
            <dt>Ideaal voor</dt><dd>Accentwand, slaapkamer, entree, hotelkamer</dd>
            <dt>Decors</dt><dd>Hout 810–812 · Japandi · Leer · Art · Travertin</dd>
          </dl>
          <p class="pd-card__foot">{% if pd_has_sig %}Beschikbaar voor {{ pd_ref }}. {% endif %}Aanbevolen: de Puredeco-look.<small>* Op een vlakke, rechte ondergrond. Hoe vlakker de wand, hoe strakker het resultaat.</small></p>
        </article>
        <article class="pd-card" data-pd-card="lin">
          <header class="pd-card__head"><h3 class="pd-card__name">Linea</h3><span>5 mm · stomp</span></header>
          <div class="pd-xsvg" aria-hidden="true"><svg viewBox="0 0 316 64"><rect x="16" y="25" width="126.5" height="2.5" fill="#7A4F36"/><rect x="145.5" y="25" width="118.5" height="2.5" fill="#7A4F36"/><g fill="none" stroke="#151413" stroke-width="1"><rect x="16" y="25" width="126.5" height="12.5"/><rect x="145.5" y="25" width="118.5" height="12.5"/></g><rect x="142.5" y="25" width="3" height="12.5" fill="#151413"/><g stroke="#151413" stroke-width="0.8"><line x1="278" y1="25" x2="278" y2="37.5"/><line x1="274" y1="25" x2="282" y2="25"/><line x1="274" y1="37.5" x2="282" y2="37.5"/></g><text x="286" y="34.5" font-size="9" fill="#151413">5 mm</text><text x="144" y="58" font-size="8" fill="#6E675E" text-anchor="middle" letter-spacing="1.5">STOMP · ZICHTBARE NAAD</text></svg></div>
          <p class="pd-card__small">Doorsnede: dunner paneel, stomp tegen elkaar geplaatst. De naad tussen de panelen blijft zichtbaar.</p>
          <dl class="pd-card__rows">
            <dt>Uitstraling</dt><dd>Zichtbare naad tussen de panelen</dd>
            <dt>Montage</dt><dd>Panelen stomp tegen elkaar</dd>
            <dt>Geschikt voor</dt><dd>Badkamer en keuken</dd>
            <dt>Decors</dt><dd>Marmer · Beton · Hout 602–615 · Japandi · Leer 646</dd>
          </dl>
          <p class="pd-card__foot">{% if pd_has_lin %}Beschikbaar voor {{ pd_ref }}. {% endif %}Standaarduitvoering.</p>
        </article>
      </div>
    </div>
  </section>

  {%- comment -%} 2 · Montage: film met meelopende hoofdstukken {%- endcomment -%}
  {%- assign pd_film = section.settings.video | default: shop.metafields.puredeco.montage_video.value -%}
  {%- assign pd_film_m = section.settings.video_mobile | default: shop.metafields.puredeco.montage_video_mobile.value -%}
  <section class="pd-s pd-mont{% if pd_film_m != blank %} has-portrait{% endif %}" data-pd-mont>
    <div class="pd-wrap">
      <header class="pd-mont__head">
        <div>
          <p class="pd-mont__eyebrow">Montage in 5 stappen · zelf te doen</p>
          <h2 class="pd-h2">Zo monteer je zelf een Puredeco-wand</h2>
        </div>
        <p class="pd-mont__lead">Geen vakman nodig: met gewoon gereedschap zet je in één dag een complete wand, zonder stof en stucwerk. Klik op een stap om er direct naartoe te gaan.</p>
      </header>

      <div class="pd-mont__frame">
        {%- if pd_film != blank -%}
          {%- if pd_film.preview_image -%}
            {{ pd_film.preview_image | image_url: width: 1920 | image_tag: loading: 'lazy', widths: '960, 1440, 1920', sizes: '(min-width: 990px) 80vw, 100vw', alt: '', class: 'pd-mont__video pd-mont__poster pd-mont__poster--land' }}
          {%- endif -%}
          <template data-pd-film="land">{{ pd_film | video_tag: muted: true, playsinline: true, preload: 'auto', class: 'pd-mont__video' }}</template>
          {%- if pd_film_m != blank -%}
            {%- if pd_film_m.preview_image -%}
              {{ pd_film_m.preview_image | image_url: width: 1080 | image_tag: loading: 'lazy', widths: '540, 810, 1080', sizes: '100vw', alt: '', class: 'pd-mont__video pd-mont__poster pd-mont__poster--port' }}
            {%- endif -%}
            <template data-pd-film="port">{{ pd_film_m | video_tag: muted: true, playsinline: true, preload: 'auto', class: 'pd-mont__video' }}</template>
          {%- endif -%}
          <button type="button" class="pd-mont__play" data-pd-mont-play aria-label="Film afspelen">
            <span class="pd-mont__play-icon" aria-hidden="true"></span>
            <span class="pd-mont__play-text" data-pd-mont-play-text>Bekijk de montage · 0:36</span>
          </button>
        {%- else -%}
          {%- liquid
            assign pd_all_imgs = product.media | where: 'media_type', 'image'
            assign pd_still = section.settings.still
            if pd_still == blank and pd_all_imgs.size > 1
              assign pd_still = pd_all_imgs.last
            endif
          -%}
          {%- if pd_still != blank -%}
            {{ pd_still | image_url: width: 1920 | image_tag: loading: 'lazy', widths: '800, 1200, 1600, 1920', sizes: '(min-width: 990px) 80vw, 100vw', alt: pd_full, class: 'pd-mont__video' }}
          {%- endif -%}
          <span class="pd-mont__soon">Montagefilm volgt</span>
        {%- endif -%}
      </div>

      <ol class="pd-mont__chapters">
        <li><button type="button" data-pd-chapter data-start="3.6" data-end="8.6"><span class="pd-mont__bar"><i></i></span><span class="pd-mont__n">01</span><strong>Voorbereiden</strong><span class="pd-mont__t">Een vlakke, droge en schone wand. Hoe vlakker, hoe strakker het resultaat.</span></button></li>
        <li><button type="button" data-pd-chapter data-start="8.6" data-end="14.6"><span class="pd-mont__bar"><i></i></span><span class="pd-mont__n">02</span><strong>Op maat maken</strong><span class="pd-mont__t">Met een fijne cirkelzaag of een stanleymes: kras langs een rei, buig en breek af.</span></button></li>
        <li><button type="button" data-pd-chapter data-start="14.6" data-end="19.8"><span class="pd-mont__bar"><i></i></span><span class="pd-mont__n">03</span><strong>Kit aanbrengen</strong><span class="pd-mont__t">Montagekit in verticale banen op de achterkant van het paneel.</span></button></li>
        <li><button type="button" data-pd-chapter data-start="19.8" data-end="27.2"><span class="pd-mont__bar"><i></i></span><span class="pd-mont__n">04</span><strong>Plaatsen en aansluiten</strong><span class="pd-mont__t">Eerste paneel waterpas. Signature klikt naadloos in elkaar; Linea wordt stomp geplaatst.</span></button></li>
        <li><button type="button" data-pd-chapter data-start="27.2" data-end="31.4"><span class="pd-mont__bar"><i></i></span><span class="pd-mont__n">05</span><strong>Afwerken</strong><span class="pd-mont__t">Profielen op hoeken en randen. Klaar, zonder stof en stucwerk.</span></button></li>
      </ol>
      <p class="pd-mont__swipe" aria-hidden="true">← swipe door de stappen →</p>
    </div>
  </section>

  {%- comment -%} 3 · Alles over {%- endcomment -%}
  <section class="pd-s pd-specs">
    <div class="pd-wrap pd-specs__grid">
      <h2 class="pd-h2">Alles over {{ pd_ref }}</h2>
      <div>
        <dl class="pd-specs__table">
          <dt>Decorcode</dt><dd>{{ pd_full }}</dd>
          <dt>Finish</dt><dd>{% if pd_has_sig %}Signature 8 mm klik{% endif %}{% if pd_has_sig and pd_has_lin %} · {% endif %}{% if pd_has_lin %}Linea 5 mm stomp{% endif %}</dd>
          {%- if pd_formats != blank -%}<dt>Formaat</dt><dd>{{ pd_formats }}</dd>{%- endif -%}
          <dt>Opbouw</dt><dd>Toplaag · gerecycled PVC · bamboekern (snelgroeiend, hernieuwbaar) · gerecyclede onderlaag</dd>
          <dt>Toepassing</dt><dd>Wonen, slapen, badkamer en keuken · waterbestendig</dd>
          <dt>Onderhoud</dt><dd>Zachte, licht vochtige doek; geen schurende middelen</dd>
          <dt>Garantie</dt><dd>3 jaar</dd>
          {%- if pd_variant.sku != blank -%}<dt>Artikelnummer</dt><dd>{{ pd_variant.sku }}</dd>{%- endif -%}
        </dl>
        {%- if product.description != blank -%}
          <details class="pd-specs__more">
            <summary>Productbeschrijving</summary>
            <div class="rte">{{ product.description }}</div>
          </details>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} 5 · In het interieur {%- endcomment -%}
  {%- assign pd_imgs = product.media | where: 'media_type', 'image' -%}
  {%- if pd_imgs.size > 1 -%}
    <section class="pd-s pd-room">
      <div class="pd-wrap">
        <h2 class="pd-h2">{{ pd_ref }} in het interieur</h2>
        <div class="pd-room__grid">
          {%- for m in pd_imgs offset: 1 limit: 3 -%}
            <figure class="pd-room__item">
              {{ m | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '400, 800, 1200', sizes: '(min-width: 990px) 30vw, 90vw', alt: pd_full }}
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 6 · Meer uit de collectie {%- endcomment -%}
  {%- liquid
    assign pd_more = product.metafields.custom.sibling_products.value
    assign pd_more_count = pd_more.size
    capture pd_eyebrow
      render 'pd-decor', product: product, part: 'eyebrow'
    endcapture
    assign pd_eyebrow_lc = pd_eyebrow | strip | downcase
    capture pd_crumb
      render 'pd-crumb-collection', product: product
    endcapture
    assign pd_crumb_parts = pd_crumb | strip | split: '||'
    assign pd_all_url = pd_crumb_parts.last
    if pd_more == blank
      for c in product.collections
        if c.handle != 'all' and c.products_count > 1
          assign pd_more = c.products
          assign pd_more_count = c.products_count
          if pd_all_url == blank
            assign pd_all_url = c.url
          endif
          break
        endif
      endfor
    endif
    if pd_eyebrow_lc != blank
      assign pd_more_title = 'Meer uit de ' | append: pd_eyebrow_lc | append: 'collectie'
    else
      assign pd_more_title = 'Verwante decors'
    endif
  -%}
  {%- if pd_more != blank -%}
    <section class="pd-s pd-more">
      <div class="pd-wrap">
        <div class="pd-more__head">
          <h2 class="pd-h2">{{ pd_more_title }}</h2>
          {%- if pd_all_url != blank -%}<a class="pd-more__all" href="{{ pd_all_url }}">Bekijk alle {{ pd_more_count }} decors →</a>{%- endif -%}
        </div>
        <div class="pd-more__grid">
          {%- assign pd_shown = 0 -%}
          {%- for p in pd_more -%}
            {%- if p.handle != product.handle and pd_shown < 4 -%}
              {%- assign pd_shown = pd_shown | plus: 1 -%}
              {%- liquid
                assign ps = false
                assign pl = false
                for o in p.options_with_values
                  for v in o.values
                    assign k = v | downcase | remove: ' ' | slice: 0, 3
                    if k == '8mm'
                      assign ps = true
                    elsif k == '5mm'
                      assign pl = true
                    endif
                  endfor
                endfor
              -%}
              <a class="pd-more__item" href="{{ p.url }}">
                <span class="pd-more__img">
                  {%- if p.featured_image -%}{{ p.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '300, 500, 800', sizes: '(min-width: 990px) 22vw, 45vw', alt: p.title }}{%- endif -%}
                  {%- if ps or pl -%}<span class="pd-more__tag">{% if ps %}Signature{% endif %}{% if ps and pl %} · {% endif %}{% if pl %}Linea{% endif %}</span>{%- endif -%}
                </span>
                {%- capture pc -%}{% render 'pd-decor', product: p, part: 'code' %}{%- endcapture -%}
                <span class="pd-more__row">
                  <span class="pd-more__name">{% if pc != blank %}<span>{{ pc | strip }}</span> {% endif %}<em>{% render 'pd-decor', product: p, part: 'name' %}</em></span>
                  <span class="pd-more__price">{% if p.price_varies %}vanaf {% endif %}{{ p.price_min | money }}</span>
                </span>
                {%- if p.title contains 'Wandpaneel' -%}<span class="pd-more__meta">per paneel · 280 × 122 cm</span>{%- endif -%}
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} 7 · Goed om te weten {%- endcomment -%}
  <section class="pd-s pd-faq">
    <div class="pd-wrap pd-faq__grid">
      <div>
        <h2 class="pd-h2">Goed om te weten</h2>
        <p class="pd-faq__lead">Staat je vraag er niet bij? <a href="https://wa.me/31316700214?text={{ 'Hallo Puredeco, ik heb een vraag over ' | append: pd_ref | url_encode }}" target="_blank" rel="noopener">App ons</a>, we reageren dezelfde dag.</p>
      </div>
      <div class="pd-faq__list">
        <details class="pd-faq__item" open>
          <summary>Kan ik de panelen zelf monteren?</summary>
          <p>Ja. Met een fijne cirkelzaag of een stanleymes, montagekit en een waterpas zet je in één dag een complete wand. Geen stucwerk, geen vakman nodig.</p>
        </details>
        <details class="pd-faq__item">
          <summary>Op welke ondergrond kan het?</summary>
          <p>Op een vlakke, droge en schone wand: stucwerk, gipsplaat, beton of bestaande tegels. Hoe vlakker de ondergrond, hoe strakker het resultaat. Signature is naadloos op een vlakke, rechte ondergrond.</p>
        </details>
        <details class="pd-faq__item">
          <summary>Is het geschikt voor badkamer en keuken?</summary>
          <p>Ja, de panelen zijn waterbestendig en geschikt voor badkamer en keuken. Linea, met zichtbare naad, is daar de standaardkeuze.</p>
        </details>
        <details class="pd-faq__item">
          <summary>Hoe zaag of snijd ik een paneel op maat?</summary>
          <p>Met een fijne cirkelzaag, of met een stanleymes: kras een paar keer langs een rei, buig het paneel en breek het af. In de montagefilm hierboven zie je hoe.</p>
        </details>
        <details class="pd-faq__item">
          <summary>Hoeveel panelen moet ik bestellen?</summary>
          <p>Vul bovenaan de breedte en hoogte van je wand in; de calculator rekent met panelen van 280 × 122 cm en laat ook de rest zien. Twijfel je? Stuur ons een foto van je wand.</p>
        </details>
      </div>
    </div>
  </section>

  {%- comment -%} 8 · Studio Herwen {%- endcomment -%}
  {%- liquid
    assign pd_studio_img = section.settings.studio_image
    if pd_studio_img == blank and pd_imgs.size > 1
      assign pd_studio_img = pd_imgs.last
    endif
  -%}
  <section class="pd-studio">
    <div class="pd-studio__img">
      {%- if pd_studio_img != blank -%}
        {{ pd_studio_img | image_url: width: 1600 | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1600', sizes: '(min-width: 990px) 55vw, 100vw', alt: '' }}
      {%- endif -%}
    </div>
    <div class="pd-studio__body">
      <p class="pd-studio__k">Studio Herwen</p>
      <h2 class="pd-h2 pd-h2--light">{{ pd_ref }} in het echt zien?</h2>
      <p class="pd-studio__t">Voel de panelen, vergelijk Signature en Linea naast elkaar en krijg advies voor jouw wand.<br>Nijverheidsdwarsstraat 2, Herwen · op afspraak</p>
      <div class="pd-studio__btns">
        <a class="pd-studio__btn" href="{{ section.settings.studio_url | default: '/pages/showroom' }}">Plan een afspraak</a>
        <a class="pd-studio__btn pd-studio__btn--line" href="https://www.google.com/maps/dir/?api=1&destination=Nijverheidsdwarsstraat+2,+6914+AX+Herwen" target="_blank" rel="noopener">Route</a>
      </div>
    </div>
  </section>
</div>

<script>
  (function () {
    var box = document.querySelector('[data-pd-mont]');
    if (!box) return;
    var frame = box.querySelector('.pd-mont__frame');
    var tplPort = box.querySelector('template[data-pd-film="port"]');
    var tplLand = box.querySelector('template[data-pd-film="land"]');
    if (!tplLand) return;
    /* Film pas laden als het blok bijna in beeld is; op mobiel de staande versie */
    var mobile = window.matchMedia('(max-width: 749px)').matches;
    var tpl = (mobile && tplPort) ? tplPort : tplLand;
    box.classList.toggle('is-portrait', tpl === tplPort);
    function load() {
      if (box.dataset.loaded) return;
      box.dataset.loaded = '1';
      var v = tpl.content.querySelector('video').cloneNode(true);
      frame.insertBefore(v, frame.firstChild);
      v.addEventListener('loadeddata', function () { box.classList.add('is-ready'); });
      pdMontSetup(v);
    }
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (e) {
        if (e[0].isIntersecting) { io.disconnect(); load(); }
      }, { rootMargin: '600px 0px' });
      io.observe(box);
    } else { load(); }
    box.querySelector('[data-pd-mont-play]').addEventListener('click', load);
  })();
  function pdMontSetup(v) {
    var box = document.querySelector('[data-pd-mont]');
    var play = box.querySelector('[data-pd-mont-play]');
    var playText = box.querySelector('[data-pd-mont-play-text]');
    var chapters = [].slice.call(box.querySelectorAll('[data-pd-chapter]'));
    v.removeAttribute('controls');
    v.loop = false;
    function start(t) {
      if (typeof t === 'number') { try { v.currentTime = t; } catch (e) {} }
      var pr = v.play(); if (pr && pr.catch) pr.catch(function () {});
    }
    play.addEventListener('click', function () { if (v.paused) { start(v.ended ? 0 : undefined); } else { v.pause(); } });
    v.addEventListener('click', function () { if (v.paused) start(); else v.pause(); });
    v.addEventListener('play', function () { box.classList.add('is-playing'); play.setAttribute('aria-label', 'Film pauzeren'); });
    v.addEventListener('pause', function () { box.classList.remove('is-playing'); play.setAttribute('aria-label', 'Film afspelen'); playText.textContent = v.ended ? 'Opnieuw bekijken' : 'Verder kijken'; });
    v.addEventListener('ended', function () { playText.textContent = 'Opnieuw bekijken'; });
    chapters.forEach(function (c) {
      c.addEventListener('click', function () { start(parseFloat(c.getAttribute('data-start'))); });
    });
    v.addEventListener('timeupdate', function () {
      var t = v.currentTime;
      chapters.forEach(function (c) {
        var a = parseFloat(c.getAttribute('data-start')), b = parseFloat(c.getAttribute('data-end'));
        var q = Math.max(0, Math.min(1, (t - a) / (b - a)));
        c.querySelector('.pd-mont__bar i').style.transform = 'scaleX(' + q + ')';
        c.classList.toggle('is-active', t >= a && t < b);
      });
    });
    /* Speelt vanzelf (zonder geluid) zodra het blok in beeld komt, pauzeert daarbuiten */
    if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      var auto = true;
      v.addEventListener('pause', function () { if (!box.dataset.offscreen) auto = false; });
      new IntersectionObserver(function (e) {
        if (e[0].isIntersecting && e[0].intersectionRatio > 0.5) { delete box.dataset.offscreen; if (auto && v.paused && !v.ended) start(); }
        else if (!v.paused) { box.dataset.offscreen = '1'; v.pause(); }
      }, { threshold: [0, 0.5] }).observe(v);
    }
    /* Mobiel: actieve stap meeschuiven in de swipe-rij */
    var row = box.querySelector('.pd-mont__chapters');
    var lastActive = null;
    v.addEventListener('timeupdate', function () {
      var a = row.querySelector('.is-active');
      if (a && a !== lastActive && row.scrollWidth > row.clientWidth) {
        lastActive = a;
        row.scrollTo({ left: row.scrollLeft + a.getBoundingClientRect().left - row.getBoundingClientRect().left - 20, behavior: 'smooth' });
      }
    });
  }
  (function () {
    var root = document.querySelector('[data-pd-choice]');
    if (!root) return;
    root.querySelectorAll('[data-pd-pick]').forEach(function (b) {
      b.addEventListener('click', function () {
        var k = b.getAttribute('data-pd-pick');
        root.querySelectorAll('[data-pd-pick]').forEach(function (x) { x.classList.toggle('is-active', x === b); });
        root.querySelectorAll('[data-pd-card]').forEach(function (c) { c.classList.toggle('is-active', c.getAttribute('data-pd-card') === k); });
      });
    });
  })();
</script>

