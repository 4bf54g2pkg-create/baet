{%- unless template == 'index' -%}
  {%- liquid
    assign justify = section.settings.text_alignment | default: 'start'
  -%}
  <div
    class="section-breadcrumb page-width page-width--{{ section.settings.container }} section--padding"
    style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <nav
      class="breadcrumbs flex items-center justify-start md:justify-{{ justify }}"
      role="navigation"
      aria-label="breadcrumbs"
    >
      <a href="{{ routes.root_url }}" title="Home" class="reversed-link">{{ 'general.breadcrumbs.home' | t }}</a>
      {%- if template contains 'page' -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        <span class="breadcrumbs--last text-subtext">{{ page.title }}</span>
      {%- elsif template contains 'product' -%}
        {%- capture pd_crumb -%}{% render 'pd-crumb-collection', product: product %}{%- endcapture -%}
        {%- assign pd_crumb = pd_crumb | strip | split: '||' -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        <a href="{{ pd_crumb[1] }}" class="reversed-link">{{ pd_crumb[0] }}</a>
        <span aria-hidden="true" class="breadcrumbs--sep breadcrumbs--sep-last"></span>
        <span class="breadcrumbs--last text-subtext">{% render 'pd-decor', product: product, part: 'full' %}</span>
      {%- elsif template contains 'collection' and collection.handle -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        {%- if current_tags -%}
          {% capture url %}{{ routes.collections_url }}/{{ collection.handle }}{% endcapture %}
          {{ collection.title | link_to: url, class: 'reversed-link' }}
          <span aria-hidden="true" class="breadcrumbs--sep"></span>
          <span class="breadcrumbs--last text-subtext">{{ current_tags | join: ' + ' }}</span>
        {%- else -%}
          <span class="breadcrumbs--last text-subtext">{{ collection.title }}</span>
        {%- endif -%}
      {%- elsif template == 'list-collections' -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        <span class="breadcrumbs--last text-subtext">{{ 'templates.collections.title' | t }}</span>
      {%- elsif template == 'blog' -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        {%- if current_tags -%}
          {{ blog.title | link_to: blog.url, class: 'reversed-link' }}
          <span aria-hidden="true" class="breadcrumbs--sep"></span>
          <span class="breadcrumbs--last text-subtext">{{ current_tags | join: ' + ' }}</span>
        {%- else -%}
          <span>{{ blog.title }}</span>
        {%- endif -%}
      {%- elsif template == 'article' -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        {{ blog.title | link_to: blog.url, class: 'reversed-link' }}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        <span class="breadcrumbs--last text-subtext">{{ article.title }}</span>
      {%- elsif template == 'cart' -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        <span class="breadcrumbs--last text-subtext">{{ 'general.cart.title' | t }}</span>
      {%- else -%}
        <span aria-hidden="true" class="breadcrumbs--sep"></span>
        <span class="breadcrumbs--last text-subtext">{{ page_title }}</span>
      {%- endif -%}
    </nav>
  </div>
  {%- comment -%} BreadcrumbList JSON-LD: gelijk aan het zichtbare kruimelpad (collectie- en productpagina's) {%- endcomment -%}
  {%- liquid
    assign bc_home_url = request.origin | append: routes.root_url
    assign bc_home_name = 'general.breadcrumbs.home' | t
    assign bc_mode = ''
    if template contains 'product'
      assign bc_mode = 'product'
    elsif template contains 'collection' and collection.handle
      assign bc_mode = 'collection'
    endif
  -%}
  {%- if bc_mode == 'product' -%}
    {%- capture pd_crumb -%}{% render 'pd-crumb-collection', product: product %}{%- endcapture -%}
    {%- liquid
      assign pd_crumb = pd_crumb | strip | split: '||'
      assign bc_col_title = pd_crumb[0]
      assign bc_col_path = pd_crumb[1]
      assign bc_col_url = request.origin | append: bc_col_path
    -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ bc_home_name | json }}, "item": {{ bc_home_url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ bc_col_title | json }}, "item": {{ bc_col_url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ canonical_url | json }} }
        ]
      }
    </script>
  {%- elsif bc_mode == 'collection' -%}
    {%- assign bc_col_url = request.origin | append: collection.url -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ bc_home_name | json }}, "item": {{ bc_home_url | json }} },
          {%- if current_tags %}
          { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ bc_col_url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ current_tags | join: ' + ' | json }} }
          {%- else %}
          { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ bc_col_url | json }} }
          {%- endif %}
        ]
      }
    </script>
  {%- endif -%}
{%- endunless -%}
{% schema %}
{
  "name": "t:sections.breadcrumbs.name",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"],
    "templates": ["index"]
  },
  "limit": 1,
  "settings": [
    {
      "type": "select",
      "id": "container",
      "options": [
        {
          "value": "full",
          "label": "t:general.container.options__full.label"
        },
        {
          "value": "fixed",
          "label": "t:general.container.options__fixed.label"
        }
      ],
      "default": "fixed",
      "label": "t:general.container.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:general.text_alignment.label",
      "options": [
        {
          "value": "start",
          "label": "t:general.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:general.text_alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:general.text_alignment.options__3.label"
        }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "t:general.padding.top.label",
      "default": 16,
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "t:general.padding.bottom.label",
      "default": 20,
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "t:sections.breadcrumbs.name"
    }
  ]
}
{% endschema %}
