{%- comment -%}
  Puredeco · ruimtegids (badkamer, toilet, keuken, woonkamer, slaapkamer, kantoor). Artboard: docs/ontwerp-puredeco-finish/InspiratieV2.dc.html
  Inhoud per ruimte: snippets/pd-gids-tekst.liquid; titel, omschrijving en decors: snippets/pd-insp.liquid (sleutel gids-<ruimte>).
  H1-test: te bekijken via /blogs/nieuws?view=gids-<ruimte> (templates/blog.gids-<ruimte>.json, noindex).
  Bij livegang: artikel 'wandpanelen-<ruimte>' aanmaken met sjabloon 'gids' (templates/article.gids.json); de ruimte volgt dan uit de handle.
  Visualisaties: assets/pd-vis-<ruimte>.jpg, gemaakt met tools/render (echte decorscans, op schaal), altijd met label 'Visualisatie'.
{%- endcomment -%}
{%- liquid
  assign room = section.settings.room | default: 'badkamer'
  if template.name == 'article'
    assign room = article.handle | split: '/' | last | remove: 'wandpanelen-'
  endif
  assign key = 'gids-' | append: room
  capture ttl
    render 'pd-insp', key: key, part: 'ttl'
  endcapture
  capture decors
    render 'pd-insp', key: key, part: 'decors'
  endcapture
  capture desc
    render 'pd-insp', key: key, part: 'desc'
  endcapture
  capture label
    render 'pd-gids-tekst', room: room, part: 'label'
  endcapture
  capture h_decors
    render 'pd-gids-tekst', room: room, part: 'h_decors'
  endcapture
  capture h_kosten
    render 'pd-gids-tekst', room: room, part: 'h_kosten'
  endcapture
  capture h_plaatsen
    render 'pd-gids-tekst', room: room, part: 'h_plaatsen'
  endcapture
  capture calc
    render 'pd-gids-tekst', room: room, part: 'calc'
  endcapture
  capture proj
    render 'pd-gids-tekst', room: room, part: 'proj'
  endcapture
  capture faq
    render 'pd-gids-tekst', room: room, part: 'faq'
  endcapture
  capture vis
    render 'pd-gids-tekst', room: room, part: 'vis'
  endcapture
  capture vis_decor
    render 'pd-gids-tekst', room: room, part: 'vis_decor'
  endcapture
  assign ttl = ttl | strip
  assign label = label | strip
  assign h_decors = h_decors | strip
  assign h_kosten = h_kosten | strip
  assign h_plaatsen = h_plaatsen | strip
  assign faq_l = faq | strip | split: '|'
  assign vis = vis | strip
  assign vis_decor = vis_decor | strip
  assign vis_p = all_products[vis_decor]
  assign dl = decors | strip | split: ','
  assign tex_p = all_products[dl[0]]
  if vis_p.id
    assign tex_p = vis_p
  endif
  assign tex = ''
  if tex_p.featured_image
    assign tex = tex_p.featured_image | image_url: width: 480, height: 1440, crop: 'center'
  endif
  assign page_url = request.path
  if template.name == 'article'
    assign page_url = article.url
  endif

  comment
    Rekenvoorbeeld per ruimte: 'producthandle|5mm of 8mm|aantal|wand|panelen'. De variant met 280 cm en de gekozen dikte.
  endcomment
  assign cp = calc | strip | split: '|'
  assign ex = all_products[cp[0]]
  assign ex_n = cp[2] | plus: 0
  assign ex_v = ex.variants | first
  for v in ex.variants
    assign vt = v.title | downcase | remove: ' '
    if vt contains '280' and vt contains cp[1]
      assign ex_v = v
      break
    endif
  endfor
  assign ex_tot = ex_v.price | times: ex_n
  assign ex_uitv = 'Linea'
  if cp[1] == '8mm'
    assign ex_uitv = 'Signature'
  endif
  assign pj = proj | strip | split: '|'
  assign pj_p = all_products[pj[3]]
  assign pj_url = blog.url | append: '/' | append: pj[0]
-%}

<article class="pda pdg">
  <div class="pdi-wrap">
    <nav class="pdi-crumb" aria-label="Kruimelpad"><a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">·</span><a href="{{ blog.url }}">Inspiratie</a><span aria-hidden="true">·</span><span>{{ label }}</span></nav>

    <header class="pdg-head">
      <div>
        <p class="pdi-k">Gids · {{ label }}</p>
        <h1 class="pdi-h1 pda-h1">{{ ttl | default: label }}</h1>
        <div class="pdg-short">
          <p class="pdi-k pdi-k--stone">Kort antwoord</p>
          <p>{% render 'pd-gids-tekst', room: room, part: 'kort' %}</p>
        </div>
      </div>
      {%- if vis != blank -%}
      <figure class="pdg-vis">
        {%- capture vis_alt -%}Visualisatie: {{ label | downcase }} met wandpanelen in {% render 'pd-decor', product: tex_p, part: 'full' %}{%- endcapture -%}
        <img src="{{ vis | asset_img_url: '1200x' }}" srcset="{{ vis | asset_img_url: '600x' }} 600w, {{ vis | asset_img_url: '900x' }} 900w, {{ vis | asset_img_url: '1200x' }} 1200w, {{ vis | asset_img_url: '1800x' }} 1800w" sizes="(min-width: 990px) 56vw, 100vw" width="1800" height="1200" alt="{{ vis_alt | strip | escape }}" fetchpriority="high">
        <figcaption><span class="pdi-tag pdi-tag--vis">Visualisatie</span><span class="pdg-vis__cap">Wand in {% render 'pd-decor', product: tex_p, part: 'full' %} · op schaal, met het echte decor</span></figcaption>
      </figure>
      {%- endif -%}
    </header>

    <nav class="pdg-toc pdg-toc--row" aria-label="In deze gids">
      <p class="pdi-k pdi-k--stone">In deze gids</p>
      <a href="#decors">Decors</a><a href="#uitvoering">Linea of Signature</a><a href="#kosten">Kosten</a><a href="#schaal">Op schaal</a><a href="#plaatsen">Plaatsen</a><a href="#onderhoud">Onderhoud</a><a href="#vragen">Vragen</a>
    </nav>

    <section class="pdg-sec" id="decors" aria-labelledby="pdg-decors">
      <p class="pdg-n">01</p>
      <h2 class="pdi-h2" id="pdg-decors">{{ h_decors }}</h2>
      <p class="pdg-p">{% render 'pd-gids-tekst', room: room, part: 'decors_p' %}</p>
      <ul class="pdg-decors" role="list">
        {%- for dh in dl -%}
          {%- assign dp = all_products[dh] -%}
          {%- if dp.id -%}
            {%- capture m2 -%}{%- render 'pd-m2', product: dp, part: 'min' -%}{%- endcapture -%}
            {%- capture eb -%}{%- render 'pd-decor', product: dp, part: 'eyebrow' -%}{%- endcapture -%}
            {%- capture cd -%}{%- render 'pd-decor', product: dp, part: 'code' -%}{%- endcapture -%}
            {%- capture nm -%}{%- render 'pd-decor', product: dp, part: 'name' -%}{%- endcapture -%}
            <li><a href="{{ dp.url }}">
              {%- if dp.featured_image -%}{{ dp.featured_image | image_url: width: 500, height: 1500, crop: 'center' | image_tag: loading: 'lazy', widths: '300, 500', sizes: '(min-width: 990px) 22vw, 45vw', alt: dp.title | escape }}{%- endif -%}
              <span class="pdi-k pdi-k--stone">{{ eb | strip }}{% if cd != blank %} · {{ cd | strip }}{% endif %}</span>
              <span class="pdi-proj__t">{{ nm | strip }}</span>
              <span class="pdg-price">{% if dp.price_varies %}vanaf {% endif %}{{ dp.price_min | money }}{% if m2 != blank %} <span>· ≈ {{ m2 | strip }} per m²</span>{% endif %}</span>
            </a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <p class="pdi-note">Prijzen en prijs per m² komen live uit de winkel. Alle decors staan in de <a href="/collections/wandpanelen">collectie</a>.</p>
    </section>

    <div class="pdg-two">
      <section class="pdg-sec" id="uitvoering" aria-labelledby="pdg-uitv">
        <p class="pdg-n">02</p>
        <h2 class="pdi-h2" id="pdg-uitv">Linea of Signature</h2>
        <div class="pdg-joints">
          <div><svg viewBox="0 0 200 50" aria-hidden="true"><rect x="10" y="18" width="88" height="10" fill="#D8CFC2" stroke="#151413"/><rect x="102" y="18" width="88" height="10" fill="#D8CFC2" stroke="#151413"/><line x1="100" y1="10" x2="100" y2="36" stroke="#8C6A4A" stroke-dasharray="2 2"/></svg><p><strong>Linea</strong> · 5 mm, stomp<br><span>{% render 'pd-gids-tekst', room: room, part: 'uitv' %}</span></p></div>
          <div><svg viewBox="0 0 200 50" aria-hidden="true"><path d="M10 18h86v4h6v6H10z" fill="#D8CFC2" stroke="#151413"/><path d="M190 18h-88v4h-6v6h94z" fill="#C9BFB1" stroke="#151413"/></svg><p><strong>Signature</strong> · 8 mm, klik<br><span>Vrijwel onzichtbare naad op een vlakke, rechte ondergrond.</span></p></div>
        </div>
      </section>
      <section class="pdg-sec" id="kosten" aria-labelledby="pdg-kost">
        <p class="pdg-n">03</p>
        <h2 class="pdi-h2" id="pdg-kost">{{ h_kosten }}</h2>
        {%- if ex.id -%}
        <div class="pdg-calc">
          <p class="pdi-k pdi-k--stone">Rekenvoorbeeld</p>
          <table>
            <tr><th scope="row">Wand</th><td>{{ cp[3] }}</td></tr>
            <tr><th scope="row">Panelen</th><td>{{ cp[4] }}</td></tr>
            <tr><th scope="row">Decor</th><td><a href="{{ ex.url }}">{% render 'pd-decor', product: ex, part: 'full' %}</a> · {{ ex_uitv }} · {{ ex_v.price | money }}</td></tr>
            <tr class="pdg-calc__tot"><th scope="row">Panelen totaal</th><td>{{ ex_n }} × {{ ex_v.price | money }} = {{ ex_tot | money }}</td></tr>
          </table>
          <p class="pdi-note">Zo reken je je eigen wand uit: deel de breedte door 1,22 en rond naar boven af. Plus montagekit en eventueel profielen. Op elke productpagina rekent de calculator het voor je uit.</p>
        </div>
        {%- endif -%}
      </section>
    </div>

    <section class="pdg-sec pdg-scale" id="schaal" aria-labelledby="pdg-schaal">
      <div>
        <p class="pdg-n">04</p>
        <h2 class="pdi-h2" id="pdg-schaal">Op schaal</h2>
        <p class="pdg-p">De tekening toont vier panelen van 122 × 280 cm naast elkaar: een wand van 4,88 m breed, met het echte decor. Eén paneel bedekt ruim 3 m². {% render 'pd-gids-tekst', room: room, part: 'schaal' %}</p>
      </div>
      <figure class="pdg-fig">
        <div class="pdg-draw">{%- if room == 'kantoor' %}{% assign draw = 'werkplek' %}{% else %}{% assign draw = room %}{% endif -%}{%- render 'pd-tekening', room: draw, tex: tex, uid: section.id -%}</div>
        <figcaption class="pdi-note">Tekening op schaal · wand in {% render 'pd-decor', product: tex_p, part: 'full' %}</figcaption>
      </figure>
    </section>

    <div class="pdg-two">
      <section class="pdg-sec pdi-rte" id="plaatsen" aria-labelledby="pdg-plaats">
        <p class="pdg-n">05</p>
        <h2 class="pdi-h2" id="pdg-plaats">{{ h_plaatsen }}</h2>
        <p>{% render 'pd-gids-tekst', room: room, part: 'plaatsen_p' %}</p>
        <ol>
          <li>Haal eerst de beschermfolie van de panelen. Maak de wand schoon, droog en vetvrij.</li>
          <li>Zaag de panelen op maat met een fijne zaag, inclusief sparingen.</li>
          <li>Zet <a href="/products/hack-tack-montagekit">High Tack montagekit</a> in verticale banen op de achterkant van het paneel, ongeveer 10 tot 20 cm uit elkaar.</li>
          <li>Druk het paneel stevig aan en controleer met een waterpas.</li>
          <li>Werk randen en hoeken af met <a href="/collections/accessoires">aluminium profielen</a>.</li>
          <li>Laat de kit 24 tot 48 uur uitharden.</li>
        </ol>
      </section>
      <section class="pdg-sec pdi-rte" id="onderhoud" aria-labelledby="pdg-ond">
        <p class="pdg-n">06</p>
        <h2 class="pdi-h2" id="pdg-ond">Onderhoud</h2>
        <p>{% render 'pd-gids-tekst', room: room, part: 'ond' %}</p>
        <p><a href="/blogs/nieuws/tips-voor-het-onderhouden-van-je-bamboepanelen">Meer over onderhoud →</a></p>
        {%- if pj_p.id -%}
        <div class="pdg-proj">
          <p class="pdi-k pdi-k--stone">Uit de praktijk</p>
          <a href="{{ pj_url }}">
            {%- if pj_p.featured_image -%}{{ pj_p.featured_image | image_url: width: 300, height: 900, crop: 'center' | image_tag: loading: 'lazy', width: 120, height: 120, alt: '' }}{%- endif -%}
            <span><span class="pdi-proj__t">{{ pj[1] }}</span><span class="pdi-note">{{ pj[2] }}</span></span>
          </a>
        </div>
        {%- endif -%}
      </section>
    </div>

    <section class="pdg-sec pdi-split" id="vragen" aria-labelledby="pdg-faq">
      <div><p class="pdg-n">07</p><h2 class="pdi-h2" id="pdg-faq">Veelgestelde vragen</h2></div>
      <div class="pdi-faq">
        {%- for f in faq_l -%}{%- assign fq = f | split: '::' -%}
        <details><summary>{{ fq[0] }}</summary><p>{{ fq[1] }}</p></details>
        {%- endfor -%}
      </div>
    </section>

    <aside class="pda-cta">
      <p class="pdi-k">Eerst voelen</p>
      <p class="pda-cta__t">Bestel gratis stalen van deze decors</p>
      <p class="pda-cta__links"><a href="/pages/sample">Stalen kiezen →</a><a href="/pages/showroom">Plan een bezoek in Herwen →</a></p>
    </aside>
  </div>
</article>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      "headline": {{ ttl | json }},
      "description": {{ desc | strip | json }},
      "author": { "@type": "Organization", "name": "PureDeco", "url": {{ shop.url | append: '/' | json }} },
      "publisher": { "@type": "Organization", "name": "PureDeco", "url": {{ shop.url | append: '/' | json }} },
      {%- if template.name == 'article' -%}
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
      {%- endif -%}
      "mainEntityOfPage": {{ shop.url | append: page_url | json }},
      {%- if vis != blank %}"image": [{{ vis | asset_img_url: '1800x' | prepend: 'https:' | json }}],{% endif %}
      "inLanguage": "nl"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": "Inspiratie", "item": {{ shop.url | append: blog.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ ttl | json }}, "item": {{ shop.url | append: page_url | json }} }
      ]
    },
    {
      "@type": "ItemList",
      "name": {{ 'Decors voor ' | append: label | downcase | json }},
      "itemListElement": [
        {%- for dh in dl -%}{%- assign dp = all_products[dh] -%}
        { "@type": "ListItem", "position": {{ forloop.index }}, "url": {{ shop.url | append: dp.url | json }}, "name": {{ dp.title | json }} }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for f in faq_l -%}{%- assign fq = f | split: '::' -%}
        { "@type": "Question", "name": {{ fq[0] | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ fq[1] | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  ]
}
</script>

{% schema %}
{
  "name": "Puredeco ruimtegids",
  "tag": "div",
  "class": "pd-gids-section",
  "settings": [
    { "type": "select", "id": "room", "label": "Ruimte", "default": "badkamer", "options": [{ "value": "badkamer", "label": "Badkamer" }, { "value": "toilet", "label": "Toilet" }, { "value": "keuken", "label": "Keuken" }, { "value": "woonkamer", "label": "Woonkamer" }, { "value": "slaapkamer", "label": "Slaapkamer" }, { "value": "kantoor", "label": "Kantoor" }] }
  ]
}
{% endschema %}
