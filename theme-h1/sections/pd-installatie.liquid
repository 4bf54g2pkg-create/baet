    {
      "@type": "HowTo",
      "name": "Wandpanelen plaatsen",
      "description": "Zo plaats je wandpanelen zelf met montagekit, op een vlakke wand of over bestaande tegels.",
      "inLanguage": "nl",
      "tool": [{ "@type": "HowToTool", "name": "Kitpistool" }, { "@type": "HowToTool", "name": "Fijne cirkelzaag of stanleymes" }, { "@type": "HowToTool", "name": "Waterpas" }],
      "supply": [{ "@type": "HowToSupply", "name": "High Tack montagekit" }, { "@type": "HowToSupply", "name": "Aluminium profielen" }],
      "step": [
        { "@type": "HowToStep", "position": 1, "name": "Voorbereiden", "text": "Haal eerst de beschermfolie van de panelen. Maak de wand vlak, schoon, droog en vetvrij. Zet met een waterpas een lijn voor het eerste paneel." },
        { "@type": "HowToStep", "position": 2, "name": "Op maat maken", "text": "Zaag met een fijne cirkelzaag of kras met een stanleymes langs een rei, buig en breek af. Zaag sparingen vooraf uit." },
        { "@type": "HowToStep", "position": 3, "name": "Kit aanbrengen", "text": "Zet High Tack montagekit in verticale banen op de achterkant van het paneel, ongeveer 10 tot 20 cm uit elkaar." },
        { "@type": "HowToStep", "position": 4, "name": "Plaatsen en aansluiten", "text": "Druk het eerste paneel waterpas en stevig aan. Je hebt ongeveer 15 minuten om bij te stellen. Tape de panelen tijdelijk aan elkaar." },
        { "@type": "HowToStep", "position": 5, "name": "Afwerken", "text": "Werk randen en hoeken af met aluminium profielen en laat de kit 24 tot 48 uur uitharden." }
      ]
