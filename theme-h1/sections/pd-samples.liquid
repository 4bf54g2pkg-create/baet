{%- comment -%}
  Puredeco · The Puredeco Edit: alle decors met "+ Sample", tot 5 stalen, vaste balk onderin.
  Stalen gaan in de winkelmand zoals de Product Samples-app het doet: het echte decor met de eigenschap "Voorbeeld van".
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign src = s.collection | default: collections['wandpanelen']
  assign max = s.max | default: 5
  assign groups = 'Hout|Beton ciré en travertin|Japandi|Leer|Art|Marmer' | split: '|'
-%}
<div class="ph pse" data-pse data-max="{{ max }}" data-prop="{{ s.property | default: 'Voorbeeld van' | escape }}">
  <section class="pse__head">
    <div class="ph-wrap pse__head-in">
      <div>
        <p class="ph-k ph-k--bronze">The Puredeco Edit</p>
        <h1 class="ph-h2 pse__h">Voel de kwaliteit zelf</h1>
      </div>
      <div>
        <p class="ph-lead">Kies tot {{ max }} decors. Je krijgt een staal thuisgestuurd: buig het, leg het naast een ander paneel en bekijk het in je eigen licht. Stalen zijn gratis, je betaalt alleen {{ s.shipping }} verzending. {{ s.delivery | capitalize }}.</p>
        <ol class="pse__steps">
          <li><span>1</span>Kies tot {{ max }} decors</li>
          <li><span>2</span>Gratis staal, {{ s.shipping }} verzending</li>
          <li><span>3</span>{{ s.delivery | capitalize }}</li>
        </ol>
      </div>
    </div>
  </section>

  <section class="pse__body">
    <div class="ph-wrap">
      <div class="pse__filters" role="tablist" aria-label="Filter op collectie">
        <button type="button" class="is-on" data-pse-filter="all">Alles</button>
        {%- for g in groups -%}<button type="button" data-pse-filter="{{ g | handle }}">{{ g }}</button>{%- endfor -%}
      </div>

      <ul class="pse__grid" role="list">
        {%- for g in groups -%}
        <li class="pse__gh" data-group="{{ g | handle }}"><span class="s">{{ g }}</span></li>
        {%- for p in src.products -%}
          {%- liquid
            capture code
              render 'pd-decor', product: p, part: 'code'
            endcapture
            assign code = code | strip
            if code == blank
              continue
            endif
            capture name
              render 'pd-decor', product: p, part: 'name'
            endcapture
            assign name = name | strip
            assign t = p.title | downcase
            assign grp = ''
            if t contains 'marmer'
              assign grp = 'Marmer'
            elsif t contains 'hout'
              assign grp = 'Hout'
            elsif t contains 'japandi' or t contains 'japanse'
              assign grp = 'Japandi'
            elsif t contains 'leer'
              assign grp = 'Leer'
            elsif t contains ' art '
              assign grp = 'Art'
            elsif t contains 'travertin' or t contains 'beton' or t contains 'concrete' or t contains 'steen'
              assign grp = 'Beton ciré en travertin'
            endif
            if grp != g
              continue
            endif
            assign v = p.selected_or_first_available_variant
          -%}
          {%- if v -%}
            <li class="pse__item" data-group="{{ grp | handle }}">
              <a class="pse__sw" href="{{ p.url }}" style="background-image:url('{{ p.featured_image | image_url: width: 900 }}')" aria-label="{{ code }} {{ name }} bekijken"></a>
              <div class="pse__meta">
                <p class="pse__name"><span>{{ code }}</span> {{ name }}</p>
              </div>
              <button type="button" class="pse__add" data-pse-add data-id="{{ v.id }}" data-title="{{ p.title | escape }}" data-label="{{ code }} {{ name | escape }}" data-img="{{ p.featured_image | image_url: width: 200 }}">
                <span class="pse__add-off">+ Sample · € 0</span><span class="pse__add-on">✓ Gekozen</span>
              </button>
            </li>
          {%- endif -%}
        {%- endfor -%}
        {%- endfor -%}
      </ul>
      <p class="ph-note">Zie je een decor niet? <a href="https://wa.me/31316700214?text={{ 'Hallo Puredeco, ik zoek een staal van ' | url_encode }}" target="_blank" rel="noopener">App ons</a>, dan kijken we mee.</p>
    </div>
  </section>

  <div class="pse__bar" data-pse-bar aria-live="polite">
    <div class="ph-wrap pse__bar-in">
      <ul class="pse__chosen" data-pse-chosen role="list"></ul>
      <p class="pse__count"><strong data-pse-count>0</strong> van {{ max }} gekozen · verzending {{ s.shipping }} · {{ s.delivery }}</p>
      <button type="button" class="pse__go" data-pse-go disabled>Samples aanvragen</button>
    </div>
    <p class="pse__msg" data-pse-msg hidden></p>
  </div>
</div>

<script>
(function () {
  var root = document.querySelector('[data-pse]');
  if (!root) return;
  var MAX = parseInt(root.dataset.max, 10) || 5, PROP = root.dataset.prop, KEY = 'pd-edit';
  var chosen = [];
  try { chosen = JSON.parse(localStorage.getItem(KEY) || '[]') || []; } catch (e) {}
  var btns = [].slice.call(root.querySelectorAll('[data-pse-add]'));
  var list = root.querySelector('[data-pse-chosen]'), count = root.querySelector('[data-pse-count]');
  var go = root.querySelector('[data-pse-go]'), bar = root.querySelector('[data-pse-bar]'), msg = root.querySelector('[data-pse-msg]');
  chosen = chosen.filter(function (c) { return btns.some(function (b) { return b.dataset.id === c.id; }); });
  function save() { try { localStorage.setItem(KEY, JSON.stringify(chosen)); } catch (e) {} }
  function say(t) { msg.hidden = !t; msg.textContent = t || ''; }
  function render() {
    btns.forEach(function (b) {
      var on = chosen.some(function (c) { return c.id === b.dataset.id; });
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', on ? 'true' : 'false');
      b.disabled = !on && chosen.length >= MAX;
    });
    list.innerHTML = '';
    chosen.forEach(function (c) {
      var li = document.createElement('li');
      li.innerHTML = '<span class="pse__chip-img" style="background-image:url(\'' + c.img + '\')"></span><span></span><button type="button" aria-label="Verwijder">×</button>';
      li.children[1].textContent = c.label;
      li.querySelector('button').addEventListener('click', function () { chosen = chosen.filter(function (x) { return x.id !== c.id; }); save(); render(); });
      list.appendChild(li);
    });
    count.textContent = chosen.length;
    go.disabled = chosen.length === 0;
    bar.classList.toggle('is-on', chosen.length > 0);
  }
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var i = chosen.findIndex(function (c) { return c.id === b.dataset.id; });
      if (i > -1) chosen.splice(i, 1);
      else if (chosen.length < MAX) chosen.push({ id: b.dataset.id, title: b.dataset.title, label: b.dataset.label, img: b.dataset.img });
      say(''); save(); render();
    });
  });
  root.querySelectorAll('[data-pse-filter]').forEach(function (f) {
    f.addEventListener('click', function () {
      var g = f.dataset.pseFilter;
      root.querySelectorAll('[data-pse-filter]').forEach(function (x) { x.classList.toggle('is-on', x === f); });
      root.querySelectorAll('.pse__item, .pse__gh').forEach(function (it) { it.hidden = g !== 'all' && it.dataset.group !== g; });
    });
  });
  go.addEventListener('click', function () {
    if (!chosen.length) return;
    go.disabled = true; go.textContent = 'Even geduld…';
    var items = chosen.map(function (c) { var pr = {}; pr[PROP] = c.title; return { id: Number(c.id), quantity: 1, properties: pr }; });
    fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' }, body: JSON.stringify({ items: items }) })
      .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
      .then(function () { chosen = []; save(); window.location.href = '/cart'; })
      .catch(function () { go.disabled = false; go.textContent = 'Samples aanvragen'; say('Dat lukte niet. Probeer het opnieuw of app ons.'); });
  });
  render();
})();
</script>

{% schema %}
{
  "name": "Puredeco samples",
  "tag": "div",
  "class": "pd-samples-section",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collectie met alle decors", "info": "Standaard: Wandpanelen." },
    { "type": "range", "id": "max", "label": "Maximaal aantal stalen", "min": 1, "max": 6, "step": 1, "default": 5 },
    { "type": "text", "id": "shipping", "label": "Verzendkosten stalen", "default": "€ 6,95" },
    { "type": "text", "id": "delivery", "label": "Levertijd stalen", "default": "binnen 3–5 werkdagen in huis" },
    { "type": "text", "id": "property", "label": "Eigenschap in winkelmand", "default": "Voorbeeld van", "info": "Moet gelijk zijn aan wat de Product Samples-app gebruikt." }
  ],
  "presets": [{ "name": "Puredeco samples" }],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
