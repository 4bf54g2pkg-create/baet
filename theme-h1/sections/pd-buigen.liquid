  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "HowTo",
      "name": "Wandpanelen buigen voor ronde wanden",
      "description": "Alle wandpanelen van Puredeco zijn te buigen: frees de achterkant in tot aan de toplaag, verwarm het paneel en buig het mee met de wand.",
      "inLanguage": "nl",
      "step": [
        { "@type": "HowToStep", "position": 1, "text": "Meet de ronde wand en bepaal welk deel van het paneel moet buigen." },
        { "@type": "HowToStep", "position": 2, "text": "Frees aan de achterkant sleuven over het deel dat moet buigen, tot aan de toplaag. Frees niet in de toplaag." },
        { "@type": "HowToStep", "position": 3, "text": "Verwarm het paneel gelijkmatig over het ingefreesde deel." },
        { "@type": "HowToStep", "position": 4, "text": "Buig het paneel rustig mee met de wand en plaats het met montagekit." },
        { "@type": "HowToStep", "position": 5, "text": "Werk de randen af met aluminium profielen." }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: '/' | json }} },
        { "@type": "ListItem", "position": 2, "name": "Inspiratie", "item": {{ shop.url | append: '/blogs/nieuws' | json }} },
        { "@type": "ListItem", "position": 3, "name": "Wandpanelen buigen voor ronde wanden", "item": {{ shop.url | append: page_url | json }} }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {%- for f in faq -%}{%- assign fq = f | split: '::' -%}
        { "@type": "Question", "name": {{ fq[0] | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ fq[1] | json }} } }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  ]
}
</script>

