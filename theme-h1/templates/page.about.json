        "text_7h6LaE": {
          "type": "text",
          "settings": {
            "text": "<p>We believe you shouldn't have to choose between style and sustainability. Our wall panels are made from high-quality materials like bamboo, FSC-certified wood, and recycled felt. Whether you prefer a warm wood finish or a sleek, modern design, PureDeco wall panels will create a space that exudes tranquility and ambiance.</p>",
            "text_size": "text-base",
            "text_line_limit": "none",
            "button_style": "btn--underline",
