            "highlight_text_color": "",
            "heading_size": "h2"
          }
        },
        "text_yYcLjt": {
          "type": "text",
          "settings": {
            "text": "<p>PureDeco was born from a love of materials that tell a story. After years in the construction and interior design industry, we saw an opportunity to create stylish, functional, and sustainable solutions. Our flagship product? Our own bamboo panels: wall panels with a bamboo core and a recycled PVC top layer, available in various finishes, including wood, leather, and marble.</p><p>What started as a small idea quickly grew into a brand offering innovative, acoustic, and aesthetic solutions for every space. From living rooms to offices, our wall panels make a difference everywhere.</p>",
            "text_size": "text-base",
            "text_line_limit": "none",
            "button_style": "btn--underline",
            "button_icon": "none"
          }
        }
