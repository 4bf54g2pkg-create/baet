        "text_3kxz9L": {
          "type": "text",
          "settings": {
            "text": "<p>Bij PureDeco draait alles om jouw interieur. Met oog voor design en duurzaamheid maken we wandpanelen die niet alleen jouw interieur transformeren, maar ook goed zijn voor de planeet.<br/><br/></p>",
            "text_size": "text-base",
