{%- comment -%}
  Puredeco: zwevende knop 'Vraag het ons' via WhatsApp (vervangt de Shopify Inbox-chat, die eerst om inloggen vraagt).
  Eén tik opent WhatsApp met een klaarstaand bericht; op een productpagina staan decor en link er al in.
  Nummer: Thema-instellingen › Puredeco · decors › WhatsApp-nummer (internationaal, zonder + of spaties).
  Staat boven de vaste koopbalk (productpagina) en samplebalk; op mobiel verborgen waar een eigen balk met 'Advies' staat.
{%- endcomment -%}
{%- liquid
  assign pd_wa_nr = settings.pd_whatsapp | default: '31316700214' | remove: '+' | remove: ' ' | remove: '-'
  case template.name
    when 'product'
      capture pd_wa_onderwerp
        render 'pd-decor', product: product, part: 'full'
      endcapture
      assign pd_wa_onderwerp = pd_wa_onderwerp | strip
      if pd_wa_onderwerp == blank
        assign pd_wa_onderwerp = product.title
      endif
      assign pd_wa_tekst = 'Hoi PureDeco, ik heb een vraag over ' | append: pd_wa_onderwerp | append: '. ' | append: shop.url | append: product.url
    when 'collection'
      assign pd_wa_tekst = 'Hoi PureDeco, ik heb een vraag over ' | append: collection.title | append: '.'
    else
      if page.handle == 'sample'
        assign pd_wa_tekst = 'Hoi PureDeco, ik heb een vraag over de stalen.'
      else
        assign pd_wa_tekst = 'Hoi PureDeco, ik heb een vraag over wandpanelen.'
      endif
  endcase
-%}
<a class="pd-wa" href="https://wa.me/{{ pd_wa_nr }}?text={{ pd_wa_tekst | url_encode }}" target="_blank" rel="noopener" data-pd-wa aria-label="Vraag het ons via WhatsApp">
  <span class="pd-wa__i" aria-hidden="true"><svg width="17" height="17" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm5.3 14.1c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.1-4.5-3.9-4.7-4.1-.1-.2-1.1-1.5-1.1-2.9s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.9 2.1c.1.2.1.4 0 .5l-.3.5-.4.4c-.1.1-.3.3-.1.6.2.3.7 1.2 1.6 1.9 1.1 1 2 1.3 2.3 1.4.3.1.4.1.6-.1l.8-1c.2-.3.4-.2.6-.1l2 1c.3.1.5.2.5.3.1.2.1.7-.1 1.2z"/></svg></span>
  <span class="pd-wa__t">Vraag het ons<small>via WhatsApp · geen inlog</small></span>
</a>
<script>
(function () {
  var a = document.querySelector('[data-pd-wa]');
  if (!a || a.dataset.ready) return;
  a.dataset.ready = '1';
  a.addEventListener('click', function () {
    try { if (window.gtag) gtag('event', 'contact', { method: 'whatsapp', page_type: '{{ template.name }}' }); } catch (e) {}
    try { (window.dataLayer = window.dataLayer || []).push({ event: 'whatsapp_click', page_type: '{{ template.name }}' }); } catch (e) {}
  });
})();
</script>
