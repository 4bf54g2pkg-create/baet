{%- when 'product' -%}
  {%- if part == 'title' or part == 'desc' or part == 'mat' -%}
    {%- liquid
      capture sc
        render 'pd-decor', product: p, part: 'code'
      endcapture
      assign sc = sc | strip
      if sc != blank
        capture sn
          render 'pd-decor', product: p, part: 'name'
        endcapture
        capture se
          render 'pd-decor', product: p, part: 'eyebrow'
        endcapture
        assign sn = sn | strip
        assign sl = se | append: ' ' | append: p.title | downcase
        assign mat = 'Wandpaneel'
        assign unit = 'per paneel'
        if sl contains 'doorlopend'
          assign mat = 'Doorlopend marmer wandpaneel'
          assign unit = 'per set van drie panelen'
        elsif sl contains 'hout'
          assign mat = 'Houten wandpaneel'
        elsif sl contains 'japandi'
          assign mat = 'Japandi wandpaneel'
        elsif sl contains 'leer'
          assign mat = 'Leerlook wandpaneel'
        elsif sl contains 'marmer'
          assign mat = 'Marmerlook wandpaneel'
        elsif sl contains 'beton'
          assign mat = 'Betonlook wandpaneel'
        elsif sl contains 'travertin'
          assign mat = 'Travertinlook wandpaneel'
        elsif sl contains 'metaal'
          assign mat = 'Metaallook wandpaneel'
        elsif sl contains ' art '
          assign mat = 'Art wandpaneel'
        endif
        assign f5 = false
        assign f8 = false
        assign size = ''
        for o in p.options_with_values
          for ov in o.values
            assign ok = ov | downcase | remove: ' '
            if ok contains '8mm'
              assign f8 = true
            elsif ok contains '5mm'
              assign f5 = true
            elsif ok contains 'x' or ok contains '×'
              unless ok contains '('
                assign sz = ok | remove: 'cm' | replace: '×', 'x' | split: 'x'
                if size == blank
                  assign size = sz | join: ' × ' | append: ' cm'
                  assign size_w = sz.last
                  assign size_h = sz.first
                elsif sz.last == size_w and sz.first != size_h
                  assign h_lo = size_h
                  assign h_hi = sz.first
                  if sz.first < size_h
                    assign h_lo = sz.first
                    assign h_hi = size_h
                  endif
                  assign size = h_lo | append: ' of ' | append: h_hi | append: ' × ' | append: size_w | append: ' cm'
                endif
              endunless
            endif
          endfor
        endfor
        assign label = mat | append: ' ' | append: sc | append: ' ' | append: sn
        case part
          when 'mat'
            echo mat
          when 'title'
            assign mid = size
            if f8
              assign mid = '8 mm naadloos'
            endif
            assign t = label
            if mid != blank
              assign t = t | append: ' | ' | append: mid
            endif
            assign t = t | append: ' | PureDeco'
            if t.size > 68
              assign t = label | append: ' | PureDeco'
            endif
            echo t
          when 'desc'
            if true
              assign fin = ''
              if f5 and f8
                assign fin = ' 5 mm stomp of 8 mm naadloos.'
              elsif f8
                assign fin = ' 8 mm naadloos met kliksysteem.'
              elsif f5
                assign fin = ' 5 mm stomp.'
              endif
              assign d = label | append: ' met bamboekern'
              if size != blank
                assign d = d | append: ', ' | append: size
              endif
              assign pr = p.price_min | money
              echo d | append: '.' | append: fin | append: ' Vanaf ' | append: pr | append: ' ' | append: unit | append: '. Gratis stalen, 3 jaar garantie.'
            endif
        endcase
      endif
    -%}
  {%- endif -%}
{%- endcase -%}
