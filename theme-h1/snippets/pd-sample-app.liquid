{%- comment -%}
  Puredeco: geeft een staal door aan de Product Samples-app.
  De app maakt zelf de bestelling aan (stalen € 0 + verzending via conceptorder); de gewone winkelmand rekent
  de paneelprijs. We drukken daarom de echte app-knop ([product-samples-button]) in, net als de live-site doet;
  de app opent dan zijn eigen venster. Staat de knop niet op deze pagina, dan gaan we naar de productpagina
  van het eerste gekozen decor (#pd-sample) en drukken hem daar in.
  Gebruik: {% render 'pd-sample-app' %} op de samplepagina én de productpagina;
  daarna window.pdSampleApp.add(['/products/...']).
{%- endcomment -%}
<script>
window.pdSampleApp = window.pdSampleApp || (function () {
  var BTN = '[product-samples-button]', HASH = '#pd-sample';
  function wait(fn, ms) {
    return new Promise(function (ok, no) {
      var t0 = Date.now();
      (function tick() { var r; try { r = fn(); } catch (e) {} if (r) return ok(r); if (Date.now() - t0 > ms) return no(); setTimeout(tick, 150); })();
    });
  }
  function press() {
    return wait(function () { return document.querySelector(BTN); }, 8000).then(function (b) { b.click(); return true; });
  }
  function boot() {
    if (location.hash !== HASH) return;
    try { history.replaceState(null, '', location.pathname + location.search); } catch (e) {}
    press().catch(function () {});
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  return {
    add: function (urls) {
      urls = (urls || []).filter(Boolean);
      if (document.querySelector(BTN)) return press();
      if (!urls.length) return Promise.reject(new Error('none'));
      location.href = urls[0].split('#')[0] + HASH;
      return Promise.resolve(true);
    }
  };
})();
</script>
