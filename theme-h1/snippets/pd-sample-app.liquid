{%- comment -%}
  Puredeco: zet gekozen stalen in de samplebox van de Product Samples-app (logica "separated-sample-box").
  De app bewaart zijn lijst in localStorage onder "product_samples" als { variant-id: product-JSON } en
  rekent zelf af via een conceptorder (stalen € 0 + verzending). De gewone winkelmand rekent de paneelprijs,
  dus daar komen stalen nooit in. Na het vullen laten we de app zijn lijst opnieuw lezen en openen
  (events reInitWidget / renderWidget op <body>, zoals de app zelf doet).
  Gebruik: {% render 'pd-sample-app' %}; daarna window.pdSampleApp.add([{ id: variant-id, url: '/products/...' }]).
{%- endcomment -%}
<script>
window.pdSampleApp = window.pdSampleApp || (function () {
  var KEY = 'product_samples';
  function read() { try { return JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { return {}; } }
  function fire(name) { try { document.body.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: {} })); } catch (e) {} }
  function product(url) {
    return fetch(url.split('#')[0].split('?')[0] + '.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
  }
  return {
    add: function (items) {
      items = (items || []).filter(function (x) { return x && x.id && x.url; });
      if (!items.length) return Promise.reject(new Error('none'));
      return Promise.all(items.map(function (x) {
        return product(x.url).then(function (p) { return { id: String(x.id), p: p }; }, function () { return null; });
      })).then(function (list) {
        var box = read(), n = 0;
        list.forEach(function (x) {
          if (!x || !x.p || !x.p.variants) return;
          var v = x.p.variants.filter(function (y) { return String(y.id) === x.id; })[0];
          x.p.sample_image = v && v.featured_image && v.featured_image.src ? v.featured_image.src : x.p.featured_image;
          box[x.id] = x.p; n++;
        });
        if (!n) throw new Error('none');
        try { localStorage.setItem(KEY, JSON.stringify(box)); } catch (e) { throw new Error('storage'); }
        fire('reInitWidget.productSamples');
        fire('showWidget.productSamples');
        fire('renderWidget.productSamples');
        return n;
      });
    },
    opened: function () { return document.body.classList.contains('product-samples-widget--active'); }
  };
})();
</script>
