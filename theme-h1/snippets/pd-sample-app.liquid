{%- comment -%}
  Puredeco: zet gekozen stalen in de samplebox van de Product Samples-app (logica "separated-sample-box").
  De app bewaart zijn lijst in localStorage onder "product_samples" als { variant-id: product-JSON } en
  rekent zelf af via een conceptorder (stalen € 0 + verzending). De gewone winkelmand rekent de paneelprijs,
  dus daar komen stalen nooit in. Na het vullen laten we de app zijn lijst opnieuw lezen (events
  reInitWidget / renderWidget op <body>, zoals de app zelf doet) en drukken we de afrekenknop van de app in.
  Gebruik: {% render 'pd-sample-app' %}; daarna window.pdSampleApp.checkout([{ id: variant-id, url: '/products/...' }]).
{%- endcomment -%}
<script>
window.pdSampleApp = window.pdSampleApp || (function () {
  var KEY = 'product_samples';
  function read() { try { return JSON.parse(localStorage.getItem(KEY) || '{}') || {}; } catch (e) { return {}; } }
  function fire(name) { try { document.body.dispatchEvent(new CustomEvent(name, { bubbles: true, detail: {} })); } catch (e) {} }
  function product(url) {
    return fetch(url.split('#')[0].split('?')[0] + '.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
  }
  function fill(items) {
    items = (items || []).filter(function (x) { return x && x.id && x.url; });
    if (!items.length) return Promise.reject(new Error('none'));
    return Promise.all(items.map(function (x) {
      return product(x.url).then(function (p) { return { id: String(x.id), p: p }; }, function () { return null; });
    })).then(function (list) {
      var old = read(), box = {}, n = 0;
      if (old.order_id) box.order_id = old.order_id;
      list.forEach(function (x) {
        if (!x || !x.p || !x.p.variants) return;
        var v = x.p.variants.filter(function (y) { return String(y.id) === x.id; })[0];
        x.p.sample_image = v && v.featured_image && v.featured_image.src ? v.featured_image.src : x.p.featured_image;
        box[x.id] = x.p; n++;
      });
      if (!n) throw new Error('none');
      try { localStorage.setItem(KEY, JSON.stringify(box)); } catch (e) { throw new Error('storage'); }
      return n;
    });
  }
  function wait(fn, ms) {
    return new Promise(function (ok, no) {
      var t0 = Date.now();
      (function tick() { var r; try { r = fn(); } catch (e) {} if (r) return ok(r); if (Date.now() - t0 > ms) return no(new Error('timeout')); setTimeout(tick, 150); })();
    });
  }
  return {
    /* Zet de stalen in de app en start meteen het afrekenen van de app (conceptorder → afrekenpagina).
       De samplebalk van de app blijft verborgen (zie puredeco-premium.css). */
    checkout: function (items) {
      return fill(items).then(function (n) {
        document.documentElement.classList.add('pd-sample-checkout');
        fire('reInitWidget.productSamples');
        fire('renderWidget.productSamples');
        return wait(function () {
          var w = document.querySelector('[data-samples-widget]');
          var b = w && w.querySelector('[data-samples-widget-checkout]');
          return b && !b.disabled && w.querySelectorAll('.product-samples-item').length >= n ? b : null;
        }, 15000).then(function (b) { b.click(); return n; });
      }).catch(function (e) {
        document.body.classList.remove('product-samples-widget--active');
        document.documentElement.classList.remove('pd-sample-checkout');
        throw e;
      });
    }
  };
})();
</script>
