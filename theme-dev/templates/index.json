ssies te doen aan uitstraling of kwaliteit.</p><p>Zo combineren we design en hoogwaardige afwerking met een bewuste keuze voor mens en milieu.</p>"}}},"block_order":["feature_card_jBhnwg","feature_card_jFUFfK","feature_card_n7yMJr"],"name":"Feature cards with icons","settings":{"heading":"Wandpanelen specialist voor interieur & projecten","container_width":1500,"section_bg":"#ffffff","side_padding":30,"mobile_side_padding":16,"padding_top":0,"padding_bottom":30,"mobile_padding_top":20,"mobile_padding_bottom":24,"heading_align":"left","mobile_heading_align":"left","heading_color":"#1A1A18","heading_size":40,"mobile_heading_size":28,"heading_weight":400,"heading_letter_spacing":0,"heading_bottom_space":60,"mobile_heading_bottom_space":45,"columns_desktop":3,"columns_tablet":2,"columns_mobile":1,"card_gap":21,"mobile_card_gap":48,"card_bg":"#ffffff","border_color":"#e7ebef","border_width":1,"card_radius":6,"card_min_height":335,"card_padding_top":58,"card_padding_right":21,"card_padding_bottom":24,"card_padding_left":21,"mobile_card_padding_top":58,"mobile_card_padding_right":22,"mobile_card_padding_bottom":24,"mobile_card_padding_left":22,"shadow_x":0,"shadow_y":1,"shadow_blur":3,"shadow_spread":0,"shadow_color":"#00000014","icon_circle_size":62,"icon_size":34,"icon_circle_bg":"#ffffff","icon_circle_border_color":"#e9edf2","icon_circle_border_width":1,"icon_color":"#000000","icon_shadow_x":0,"icon_shadow_y":1,"icon_shadow_blur":5,"icon_shadow_spread":0,"icon_shadow_color":"#0000001f","title_color":"#1A1A18","title_size":19,"mobile_title_size":17,"title_weight":500,"title_letter_spacing":0,"title_bottom_space":24,"text_color":"#3A3A36","text_size":16,"mobile_text_size":16,"text_weight":400,"text_letter_spacing":0}},"contact_help_section_cWkrh6":{"type":"contact-help-section","blocks":{"contact_item_3wWNbi":{"type":"contact_item","settings":{"icon":"whatsapp","label":"WhatsApp","value":"0316 700214","link":"https://wa.me/31316700214","open_new_tab":true}},"contact_item_